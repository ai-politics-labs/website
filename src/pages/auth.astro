---
import CommunityLayout from '../layouts/CommunityLayout.astro';
---

<CommunityLayout title="로그인 · AI정당" description="AI정당 사이트에 가입하고 자유게시판과 나의 초대 링크를 이용하세요." active="auth" variant="auth">
  <div class="auth-stage">
  <div class="auth-shell" id="auth-root" aria-busy="true">
    <header class="auth-heading">
      <span class="auth-symbol" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 4H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h7M10 4l5 2v12l-5 2V4Z" />
          <path d="M12 12h8m-3-3 3 3-3 3" />
        </svg>
      </span>
      <h1 id="auth-title" class="c-heading" tabindex="-1">로그인</h1>
      <p class="c-muted" id="auth-description">발기인 동의로 가입한 계정으로 로그인하세요.</p>
    </header>

    <p id="auth-message" class="c-message" role="status" aria-live="polite" aria-atomic="true">로그인 상태를 확인하고 있습니다.</p>

    <section id="login-panel" class="auth-panel" aria-labelledby="login-heading" hidden>
      <h2 id="login-heading">이메일로 로그인</h2>
      <form id="login-form" class="c-form" method="post">
        <div class="c-field">
          <label for="login-email">이메일</label>
          <input id="login-email" class="c-input" type="email" name="email" autocomplete="email" placeholder="you@email.com" required maxlength="254" />
        </div>
        <div class="c-field">
          <label for="login-password">비밀번호</label>
          <input id="login-password" class="c-input" type="password" name="password" autocomplete="current-password" required />
        </div>
        <button class="c-button" type="submit">로그인</button>
      </form>
      <div class="c-actions auth-secondary-actions">
        <a class="c-link" href="/#founding-members">발기인 동의하고 가입하기</a>
        <a class="c-link" href="/auth?mode=reset" data-auth-mode="reset">비밀번호 찾기</a>
      </div>
    </section>

    <section id="signup-panel" class="auth-panel" aria-labelledby="signup-heading" hidden>
      <h2 id="signup-heading">발기인 동의로 가입하기</h2>
      <p class="c-muted">발기인 동의와 사이트 가입을 한 번에 진행합니다. 아래에서 발기인 동의서를 작성해 주세요.</p>
      <div class="c-form"><a class="c-button" href="/#founding-members">발기인 동의하고 가입하기</a></div>
    </section>

    <section id="reset-panel" class="auth-panel" aria-labelledby="reset-heading" hidden>
      <h2 id="reset-heading">비밀번호 재설정 메일 받기</h2>
      <p class="c-muted">가입한 이메일로 재설정 링크를 보내드립니다. 메일이 보이지 않으면 스팸함도 확인하세요.</p>
      <form id="reset-form" class="c-form" method="post">
        <div class="c-field">
          <label for="reset-email">이메일</label>
          <input id="reset-email" class="c-input" type="email" name="email" autocomplete="email" maxlength="254" required />
        </div>
        <button class="c-button" type="submit">재설정 메일 보내기</button>
      </form>
      <div class="c-actions auth-secondary-actions"><a class="c-link" href="/auth" data-auth-mode="login">로그인으로 돌아가기</a></div>
    </section>

    <section id="recovery-panel" class="auth-panel" aria-labelledby="recovery-heading" hidden>
      <h2 id="recovery-heading">새 비밀번호 설정</h2>
      <form id="recovery-form" class="c-form" method="post">
        <div class="c-field">
          <label for="recovery-password">새 비밀번호</label>
          <input id="recovery-password" class="c-input" type="password" name="password" autocomplete="new-password" minlength="10" required aria-describedby="recovery-password-hint" />
          <p id="recovery-password-hint" class="c-muted">10자 이상으로 입력하세요.</p>
        </div>
        <div class="c-field">
          <label for="recovery-confirm">새 비밀번호 확인</label>
          <input id="recovery-confirm" class="c-input" type="password" name="password_confirm" autocomplete="new-password" minlength="10" required />
        </div>
        <button class="c-button" type="submit">새 비밀번호 저장</button>
      </form>
    </section>

    <section id="verify-panel" class="auth-panel" aria-labelledby="verify-heading" hidden>
      <h2 id="verify-heading">이메일을 확인해 주세요</h2>
      <p class="c-muted"><span id="verification-email"></span> 메일함에서 인증 링크를 눌러 가입을 마무리하세요.</p>
      <p class="c-muted">메일이 오지 않으면 스팸함을 확인하거나 아래에서 다시 요청할 수 있습니다. 이미 가입한 이메일이라면 로그인 또는 비밀번호 찾기를 이용하세요.</p>
      <form id="resend-form" class="c-form" method="post">
        <div class="c-field">
          <label for="resend-email">인증 메일을 받을 이메일</label>
          <input id="resend-email" class="c-input" type="email" name="email" autocomplete="email" maxlength="254" required />
        </div>
        <button class="c-button c-button-secondary" type="submit">인증 메일 다시 보내기</button>
      </form>
      <div class="c-actions auth-secondary-actions">
        <a class="c-link" href="/auth" data-auth-mode="login">로그인</a>
        <a class="c-link" href="/auth?mode=reset" data-auth-mode="reset">비밀번호 찾기</a>
      </div>
    </section>

    <noscript><p class="c-message">로그인을 이용하려면 브라우저에서 JavaScript를 켜 주세요. 가입은 <a class="c-link" href="/#founding-members">발기인 동의서</a>에서 진행할 수 있습니다.</p></noscript>
  </div>
  </div>
  <script type="module" src="/community/auth.js" is:inline></script>
</CommunityLayout>

<style>
  .auth-stage { min-height: calc(100svh - 92px); width: 100%; display: grid; justify-items: center; align-items: center; padding: 48px 0 72px; }
  .auth-shell { width: min(340px, 100%); padding: 24px; border: 1px solid rgba(224, 225, 225, .75); border-radius: 20px; background: rgba(255, 255, 255, .88); box-shadow: 0 1px 4px rgba(30, 31, 32, .025); color: #27272a; }
  .auth-heading { margin-bottom: 24px; }
  .auth-symbol { display: grid; place-items: center; width: 48px; height: 48px; margin-bottom: 18px; border-radius: 50%; background: #f4f4f4; color: #8d8d91; }
  .auth-heading .c-heading { margin-bottom: 6px; font-size: 22px; line-height: 1.3; letter-spacing: -.6px; font-weight: 600; }
  .auth-heading .c-muted { font-size: 14px; line-height: 1.5; color: #808084; }
  .auth-panel > h2 { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .auth-panel > .c-muted { margin-bottom: 16px; font-size: 12px; line-height: 1.6; color: #808084; }
  .auth-panel .c-form { gap: 16px; }
  .auth-panel .c-field { gap: 6px; font-size: 12px; }
  .auth-panel .c-field label { font-weight: 400; }
  .auth-panel .c-field .c-muted { font-size: 11px; line-height: 1.6; color: #909094; }
  .auth-panel .c-input { min-height: 44px; border: 1px solid #e8e8e9; border-radius: 8px; background: rgba(255, 255, 255, .85); padding: 10px 12px; font-size: 14px; color: #27272a; }
  .auth-panel .c-input::placeholder { color: #b4b4b8; }
  .auth-panel .c-button { min-height: 44px; border-radius: 8px; border-color: #303234; background: #303234; color: #fff; padding: 10px 14px; font-size: 13px; font-weight: 500; }
  .auth-panel .c-form > .c-button { width: 100%; }
  .auth-panel .c-button-secondary { background: #f5f5f5; border-color: #ededee; color: #4f5054; }
  .auth-shell .c-message { margin-block: 12px; padding: 10px 12px; border-radius: 8px; font-size: 12px; line-height: 1.6; }
  .auth-secondary-actions { display: grid; gap: 2px; margin: 20px -24px -24px; padding: 12px 24px 16px; border-top: 1px solid rgba(232, 232, 233, .8); border-radius: 0 0 19px 19px; background: rgba(250, 250, 250, .45); }
  .auth-secondary-actions a { min-height: 40px; display: flex; justify-content: center; align-items: center; border-radius: 8px; color: #727277; font-size: 12px; text-decoration: none; }
  .auth-secondary-actions a:first-child { background: #f1f1f2; color: #4f5054; }
  .auth-secondary-actions a:hover { color: #27272a; background: #eaeaec; }
  :global(.dark) .auth-shell { background: rgba(35, 35, 38, .92); border-color: #444448; color: #f4f4f5; }
  :global(.dark) .auth-symbol { background: #303034; color: #a1a1aa; }
  :global(.dark) .auth-heading .c-muted, :global(.dark) .auth-panel > .c-muted { color: #a1a1aa; }
  :global(.dark) .auth-panel .c-input { background: rgba(39, 39, 42, .9); border-color: #47474c; color: #f4f4f5; }
  :global(.dark) .auth-panel .c-button { background: #f4f4f5; border-color: #f4f4f5; color: #27272a; }
  :global(.dark) .auth-panel .c-button-secondary, :global(.dark) .auth-secondary-actions a:first-child { background: #343438; border-color: #444448; color: #d4d4d8; }
  :global(.dark) .auth-secondary-actions { background: rgba(39, 39, 42, .4); border-color: #444448; }
  @media (max-width: 480px) { .auth-stage { padding-top: 28px; padding-bottom: 48px; align-items: start; } }
</style>
