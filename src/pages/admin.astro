---
import "../styles/global.css";
---

<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
		<title>관리자 | ai politics labs</title>
	</head>
	<body class="bg-white text-stone-900 antialiased overflow-x-hidden">
		<nav class="pt-10">
			<div class="max-w-[1146px] mx-auto px-6 flex items-center justify-between">
				<a href="/" class="font-medium text-[15.84px] text-stone-900 tracking-[-0.32px]">
					ai politics labs
				</a>
				<span class="text-[14px] text-stone-400 tracking-[-0.14px]">관리자</span>
			</div>
		</nav>

		<!-- 로그인 폼 -->
		<section id="login-section" class="pt-[60px]">
			<div class="max-w-sm mx-auto px-6">
				<h1 class="font-semibold mb-6 text-[22px] text-stone-800 tracking-[-0.32px]">관리자 로그인</h1>
				<form id="login-form" class="space-y-4">
					<div>
						<label for="email" class="block text-[14px] font-medium text-stone-700 tracking-[-0.14px] mb-1.5">이메일</label>
						<input type="email" id="email" required
							class="w-full h-10 px-3 text-[15px] text-stone-900 bg-white border border-stone-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-stone-300 placeholder:text-stone-400 tracking-[-0.14px]"
							placeholder="admin@example.com" />
					</div>
					<div>
						<label for="password" class="block text-[14px] font-medium text-stone-700 tracking-[-0.14px] mb-1.5">비밀번호</label>
						<input type="password" id="password" required
							class="w-full h-10 px-3 text-[15px] text-stone-900 bg-white border border-stone-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-stone-300 placeholder:text-stone-400 tracking-[-0.14px]" />
					</div>
					<div id="login-error" class="hidden p-3 bg-red-50 rounded-xl text-[13px] text-red-600"></div>
					<button type="submit" id="login-btn"
						class="inline-flex items-center justify-center h-10 px-6 text-sm font-medium text-white bg-[#222222] rounded-full hover:bg-[#333333] transition-colors tracking-[-0.14px] w-full">
						로그인
					</button>
				</form>
			</div>
		</section>

		<!-- 데이터 테이블 -->
		<section id="data-section" class="hidden pt-[60px] pb-24">
			<div class="max-w-[1146px] mx-auto px-6">
				<div class="flex items-center justify-between mb-6">
					<h1 class="font-semibold text-[22px] text-stone-800 tracking-[-0.32px]">
						구독 접수 목록 <span id="total-count" class="text-stone-400 text-[15px] font-normal"></span>
					</h1>
					<button id="logout-btn"
						class="text-[13px] text-stone-400 hover:text-stone-600 transition-colors tracking-[-0.14px]">
						로그아웃
					</button>
				</div>

				<div id="loading" class="text-[15px] text-stone-400 tracking-[-0.14px]">불러오는 중...</div>
				<div id="members-list" class="space-y-4"></div>
			</div>
		</section>

		<script type="module">
			import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';

			const SUPABASE_URL = 'https://hjilaodigquqootzlhrp.supabase.co';
			const SUPABASE_ANON_KEY = 'sb_publishable_L-6st50djIUgSbADAwL-yg_-kbIEihy';
			const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

			const loginSection = document.getElementById('login-section');
			const dataSection = document.getElementById('data-section');
			const loginForm = document.getElementById('login-form');
			const loginError = document.getElementById('login-error');
			const membersList = document.getElementById('members-list');
			const loading = document.getElementById('loading');
			const totalCount = document.getElementById('total-count');

			// Check existing session
			const { data: { session } } = await supabase.auth.getSession();
			if (session) {
				showData();
			}

			// Login
			loginForm.addEventListener('submit', async (e) => {
				e.preventDefault();
				loginError.classList.add('hidden');
				const email = document.getElementById('email').value;
				const password = document.getElementById('password').value;

				const { error } = await supabase.auth.signInWithPassword({ email, password });
				if (error) {
					loginError.textContent = '로그인 실패: ' + error.message;
					loginError.classList.remove('hidden');
					return;
				}
				showData();
			});

			// Logout
			document.getElementById('logout-btn').addEventListener('click', async () => {
				await supabase.auth.signOut();
				loginSection.classList.remove('hidden');
				dataSection.classList.add('hidden');
			});

			// Load data
			async function showData() {
				loginSection.classList.add('hidden');
				dataSection.classList.remove('hidden');
				loading.classList.remove('hidden');
				membersList.innerHTML = '';

				const { data, error } = await supabase
					.from('support_signups')
					.select('id, created_at, phone, email, privacy_consent, consent_version, cta_position')
					.order('created_at', { ascending: false });

				loading.classList.add('hidden');

				if (error) {
					membersList.innerHTML = `<p class="text-red-500 text-[14px]">데이터 로드 실패: ${error.message}</p>`;
					return;
				}

				totalCount.textContent = `(${data.length}건)`;

				if (data.length === 0) {
					membersList.innerHTML = '<p class="text-stone-400 text-[15px]">아직 구독 접수가 없습니다.</p>';
					return;
				}

				data.forEach((m) => {
					const card = document.createElement('div');
					card.className = 'bg-stone-100 rounded-2xl p-6';
					card.innerHTML = `
						<div class="flex items-start justify-between gap-4">
							<div class="flex-1 min-w-0">
								<div class="flex items-center gap-3 mb-3">
									<span class="text-[15px] font-semibold text-stone-900 tracking-[-0.14px]">${esc(formatContact(m))}</span>
									<span class="text-[13px] text-stone-400 tracking-[-0.14px]">${formatContactType(m)}</span>
									<span class="text-[12px] text-stone-300 tracking-[-0.14px]">${formatCreatedAt(m.created_at)}</span>
								</div>
								<div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-1 text-[13px] tracking-[-0.14px]">
									<p><span class="text-stone-400">이메일</span> <span class="text-stone-700 ml-2">${esc(m.email || '-')}</span></p>
									<p><span class="text-stone-400">전화번호</span> <span class="text-stone-700 ml-2">${esc(m.phone || '-')}</span></p>
									<p><span class="text-stone-400">생성 시간</span> <span class="text-stone-700 ml-2">${formatCreatedAt(m.created_at)}</span></p>
									<p><span class="text-stone-400">위치</span> <span class="text-stone-700 ml-2">${esc(formatCtaPosition(m.cta_position))}</span></p>
									<p><span class="text-stone-400">동의</span> <span class="text-stone-700 ml-2">${m.privacy_consent ? '동의' : '-'}</span></p>
								</div>
							</div>
						</div>
					`;
					membersList.appendChild(card);
				});
			}

			function formatContact(member) {
				return member.email || member.phone || '-';
			}

			function formatContactType(member) {
				if (member.email) return '이메일';
				if (member.phone) return '전화번호';
				return '-';
			}

			function formatCtaPosition(position) {
				if (position === 'hero') return '상단';
				if (position === 'bottom') return '하단';
				return position || '-';
			}

			function formatCreatedAt(value) {
				return new Date(value).toLocaleString('ko-KR', {
					year: 'numeric',
					month: '2-digit',
					day: '2-digit',
					hour: '2-digit',
					minute: '2-digit',
				});
			}

			function esc(str) {
				const d = document.createElement('div');
				d.textContent = str;
				return d.innerHTML;
			}
		</script>
	</body>
</html>
