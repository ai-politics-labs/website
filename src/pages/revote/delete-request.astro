---
import RevoteLayout from "../../layouts/RevoteLayout.astro";
---

<RevoteLayout title="개인정보 삭제 요청 · 선거권 회복 100만 서명운동">
  <div class="max-w-4xl mx-auto px-6 py-16">
    <h1 class="font-semibold text-[32px] sm:text-[40px] text-stone-900 tracking-[-0.32px] mb-4">
      개인정보 삭제 요청
    </h1>
    <p class="text-[15px] text-stone-600 leading-7 tracking-[-0.16px] mb-10 max-w-2xl">
      서명, 피해 제보, 첨부파일 삭제를 요청할 수 있습니다.
      본인 확인 후 처리되며, 처리 결과를 입력하신 연락처로 안내드립니다.
    </p>

    <form id="delete-form" novalidate>
      <div class="bg-stone-100 rounded-2xl p-6 sm:p-8 space-y-5">

        <!-- 이름 -->
        <div>
          <label for="name" class="block text-[14px] font-medium text-stone-700 tracking-[-0.14px] mb-1.5">
            이름 <span class="text-red-500" aria-hidden="true">*</span>
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            autocomplete="name"
            placeholder="홍길동"
            class="w-full h-10 px-3 text-[15px] text-stone-900 bg-white border border-stone-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-stone-300 placeholder:text-stone-400 tracking-[-0.14px]"
          />
          <p class="field-error hidden mt-1 text-[12px] text-red-500"></p>
        </div>

        <!-- 휴대폰 번호 -->
        <div>
          <label for="phone" class="block text-[14px] font-medium text-stone-700 tracking-[-0.14px] mb-1.5">
            휴대폰 번호 <span class="text-red-500" aria-hidden="true">*</span>
          </label>
          <input
            type="tel"
            id="phone"
            name="phone"
            required
            autocomplete="tel"
            placeholder="010-0000-0000"
            class="w-full h-10 px-3 text-[15px] text-stone-900 bg-white border border-stone-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-stone-300 placeholder:text-stone-400 tracking-[-0.14px]"
          />
          <p class="field-error hidden mt-1 text-[12px] text-red-500"></p>
        </div>

        <!-- 요청 유형 -->
        <div>
          <label for="request_type" class="block text-[14px] font-medium text-stone-700 tracking-[-0.14px] mb-1.5">
            요청 유형 <span class="text-red-500" aria-hidden="true">*</span>
          </label>
          <select
            id="request_type"
            name="request_type"
            required
            class="w-full h-10 px-3 text-[15px] text-stone-900 bg-white border border-stone-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-stone-300 tracking-[-0.14px] appearance-none"
          >
            <option value="" disabled selected>요청 유형을 선택하세요</option>
            <option value="SIGNATURE">서명 삭제</option>
            <option value="REPORT">제보 삭제</option>
            <option value="FILE">첨부파일 삭제</option>
            <option value="ALL">전체 삭제</option>
          </select>
          <p class="field-error hidden mt-1 text-[12px] text-red-500"></p>
        </div>

        <!-- 본인 확인용 연락처 (선택) -->
        <div>
          <label for="contact" class="block text-[14px] font-medium text-stone-700 tracking-[-0.14px] mb-1">
            본인 확인용 연락처 <span class="text-[11px] text-stone-400 font-normal">(선택)</span>
          </label>
          <p class="text-[11px] text-stone-400 tracking-[-0.14px] mb-1.5">처리 결과를 받을 이메일 또는 추가 연락처를 입력해 주세요.</p>
          <input
            type="text"
            id="contact"
            name="contact"
            placeholder="이메일 또는 연락처"
            class="w-full h-10 px-3 text-[15px] text-stone-900 bg-white border border-stone-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-stone-300 placeholder:text-stone-400 tracking-[-0.14px]"
          />
          <p class="field-error hidden mt-1 text-[12px] text-red-500"></p>
        </div>

        <!-- 요청 사유 (선택) -->
        <div>
          <label for="reason" class="block text-[14px] font-medium text-stone-700 tracking-[-0.14px] mb-1">
            요청 사유 <span class="text-[11px] text-stone-400 font-normal">(선택)</span>
          </label>
          <textarea
            id="reason"
            name="reason"
            rows="4"
            placeholder="삭제 요청 사유를 자유롭게 입력해 주세요."
            class="w-full px-3 py-2.5 text-[15px] text-stone-900 bg-white border border-stone-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-stone-300 placeholder:text-stone-400 tracking-[-0.14px] resize-none"
          ></textarea>
          <p class="field-error hidden mt-1 text-[12px] text-red-500"></p>
        </div>

      </div>

      <!-- 제출 버튼 -->
      <div class="mt-8">
        <button
          type="submit"
          id="submit-btn"
          class="inline-flex items-center justify-center h-10 px-6 text-sm font-medium text-white bg-[#222222] rounded-full hover:bg-[#333333] transition-colors tracking-[-0.14px] disabled:opacity-40 disabled:cursor-not-allowed"
        >
          삭제 요청 제출
        </button>
      </div>
    </form>

    <!-- 성공 메시지 -->
    <div id="success-message" role="status" class="hidden mt-8 bg-stone-100 rounded-2xl p-8 text-center">
      <p class="text-[22px] font-semibold text-stone-800 tracking-[-0.32px] mb-2">
        요청이 접수되었습니다
      </p>
      <p class="text-[15px] text-stone-500 leading-6 tracking-[-0.16px]">
        삭제 요청이 접수되었습니다. 본인 확인 후 처리됩니다.
      </p>
    </div>

    <!-- 에러 메시지 -->
    <div id="error-message" role="alert" class="hidden mt-4 p-4 bg-red-50 rounded-xl text-[14px] text-red-600 leading-5"></div>

    <div class="mt-16 pt-8 border-t border-stone-200 flex flex-wrap gap-4 text-[13px] text-stone-500">
      <a href="/revote/privacy" class="hover:text-stone-800 transition-colors">개인정보처리방침 보기 →</a>
      <a href="/revote" class="hover:text-stone-800 transition-colors">캠페인 홈 →</a>
    </div>
  </div>
</RevoteLayout>

<script type="module">
  import { supabase, formatMobile, isValidMobile, track } from "/revote/revote-client.js";

  const form = document.getElementById("delete-form");
  const submitBtn = document.getElementById("submit-btn");
  const successDiv = document.getElementById("success-message");
  const errorDiv = document.getElementById("error-message");

  // Phone auto-format
  document.getElementById("phone").addEventListener("input", (e) => {
    e.target.value = formatMobile(e.target.value);
  });

  function clearErrors() {
    errorDiv.classList.add("hidden");
    document.querySelectorAll(".field-error").forEach((el) => {
      el.textContent = "";
      el.classList.add("hidden");
    });
    document.querySelectorAll(".border-red-400").forEach((el) => {
      el.classList.remove("border-red-400");
    });
  }

  function showFieldError(id, message) {
    const input = document.getElementById(id);
    if (!input) return;
    const errorEl = input.closest("div").querySelector(".field-error");
    if (errorEl) {
      errorEl.textContent = message;
      errorEl.classList.remove("hidden");
    }
    input.classList.add("border-red-400");
    input.addEventListener(
      "input",
      () => {
        input.classList.remove("border-red-400");
        if (errorEl) errorEl.classList.add("hidden");
      },
      { once: true }
    );
    return input;
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    clearErrors();

    const fd = new FormData(form);
    const name = fd.get("name")?.trim();
    const phone = fd.get("phone")?.trim();
    const request_type = fd.get("request_type");
    const contact = fd.get("contact")?.trim() || null;
    const reason = fd.get("reason")?.trim() || null;

    let firstError = null;

    if (!name || name.length < 2) {
      firstError = firstError || showFieldError("name", "이름을 2자 이상 입력해 주세요.");
    }
    if (!isValidMobile(phone)) {
      firstError = firstError || showFieldError("phone", "올바른 휴대폰 번호를 입력해 주세요.");
    }
    if (!request_type) {
      firstError = firstError || showFieldError("request_type", "요청 유형을 선택해 주세요.");
    }

    if (firstError) {
      firstError.scrollIntoView({ behavior: "smooth", block: "center" });
      firstError.focus();
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = "제출 중...";

    try {
      const { error } = await supabase.from("revote_delete_requests").insert({
        name,
        phone,
        request_type,
        contact,
        reason,
      });

      if (error) throw error;

      track("delete_request_submit", { request_type });

      form.classList.add("hidden");
      successDiv.classList.remove("hidden");
      successDiv.scrollIntoView({ behavior: "smooth", block: "center" });
    } catch (err) {
      console.error("Delete request error:", err);
      errorDiv.textContent = "제출 중 오류가 발생했습니다. 잠시 후 다시 시도해 주세요.";
      errorDiv.classList.remove("hidden");
      submitBtn.disabled = false;
      submitBtn.textContent = "삭제 요청 제출";
    }
  });
</script>
