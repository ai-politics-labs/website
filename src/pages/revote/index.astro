---
import RevoteLayout from "../../layouts/RevoteLayout.astro";
import LiveCounter from "../../components/revote/LiveCounter.astro";
import ShareBar from "../../components/revote/ShareBar.astro";
import { DEMANDS, HERO_LINES } from "../../lib/revote/constants";
---

<RevoteLayout title="선거권 회복 100만 서명운동" active="home">

  <!-- 1. Hero -->
  <section class="bg-[#0e0e0d] pt-[72px] pb-24 border-b border-stone-800">
    <div class="max-w-4xl mx-auto px-6">
      <p class="text-[12px] font-medium text-stone-500 tracking-[0.14em] uppercase mb-7">
        선거권 회복 · 시민행동
      </p>
      <h1 class="font-semibold text-[32px] sm:text-[40px] text-white leading-[1.25] tracking-[-0.32px] mb-8">
        {HERO_LINES.map((line) => (
          <span class="block">{line}</span>
        ))}
      </h1>

      <div class="space-y-5 text-[16px] sm:text-[17px] text-stone-300 leading-8 tracking-[-0.18px] max-w-2xl mb-10">
        <p>민주주의의 최소 요건이 무너졌습니다.<br />헌법이 보장하는 선거권의 명백한 침해입니다.</p>
        <p>우리는 30일 안에 100만 명의 서명을 모아<br />정부, 국회, 법원, 정당, 선관위에 전달하겠습니다.</p>
        <p class="text-white font-medium">우리의 요구는 분명합니다.</p>
        <ol class="list-decimal list-inside space-y-2 text-stone-300">
          <li>선관위 유책 공무원 전원 해임 및 채용비리 없는 재선발</li>
          <li>서울·인천·부산 등 피해 확인 지역 재선거</li>
          <li>독립적 진상조사 및 재발방지 시스템 마련</li>
        </ol>
        <p class="text-stone-400">당신의 서명은 잃어버린 주권을 회복하기 위한 첫 번째 행동입니다.</p>
      </div>

      <div class="flex flex-wrap gap-3">
        <a
          href="/revote/sign"
          class="inline-flex items-center h-10 px-4 text-sm font-medium text-stone-900 bg-white rounded-full hover:bg-stone-200 transition-colors tracking-[-0.14px]"
        >
          30초 만에 서명하기 →
        </a>
        <a
          href="/revote/report"
          class="inline-flex items-center h-10 px-4 text-sm font-medium text-stone-200 border border-stone-600 rounded-full hover:bg-white/10 transition-colors tracking-[-0.14px]"
        >
          피해 제보하기 →
        </a>
      </div>
    </div>
  </section>

  <!-- 2. 실시간 카운터 -->
  <section class="bg-white py-16">
    <div class="max-w-4xl mx-auto px-6">
      <LiveCounter variant="hero" />
    </div>
  </section>

  <!-- 3. 문제 설명 -->
  <section class="bg-stone-100 py-20">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-[22px] font-semibold text-stone-800 tracking-[-0.32px] mb-7">
        무슨 일이 있었나요?
      </h2>
      <div class="space-y-5 text-[15px] text-stone-600 leading-7 tracking-[-0.16px] max-w-xl">
        <p>
          2026년 6월 지방선거에서 14,300개 투표소 중 50곳에서 투표용지가 부족했고,
          22곳에서는 투표가 일시 중단됐습니다.
        </p>
        <p>
          장시간 대기 끝에 발걸음을 돌린 시민,<br />
          투표를 포기할 수밖에 없었던 시민이 실제로 존재합니다.
        </p>
        <p class="text-stone-800 font-medium">
          이것은 단순한 행정 실수가 아닙니다.<br />
          선거관리 부실로 인한 선거권 침해입니다.
        </p>
        <p>
          현재까지 파악된 사실은 아직 조사 중이며,
          모든 제보는 "검증 중" 단계로 수집됩니다.
          우리는 확인된 사실과 미확인 주장을 구분합니다.
        </p>
      </div>
      <div class="mt-9 flex flex-wrap gap-3">
        <a
          href="/revote/sign"
          class="inline-flex items-center h-10 px-4 text-sm font-medium text-white bg-stone-900 rounded-full hover:bg-stone-700 transition-colors tracking-[-0.14px]"
        >
          30초 만에 서명하기 →
        </a>
      </div>
    </div>
  </section>

  <!-- 4. 요구사항 3개 -->
  <section class="bg-white py-16 sm:py-24">
    <div class="max-w-5xl mx-auto px-6">
      <p class="text-[11px] sm:text-[12px] font-medium text-stone-400 tracking-[0.14em] uppercase mb-3 sm:mb-4">
        우리의 요구
      </p>
      <h2 class="text-[25px] sm:text-[40px] font-semibold text-stone-900 leading-[1.15] tracking-[-0.4px] mb-8 sm:mb-12">
        우리의 요구사항
      </h2>
      <div class="divide-y divide-stone-200 border-t-2 border-b-2 border-stone-900">
        {DEMANDS.map((demand, i) => (
          <div class="py-5 sm:py-8 flex items-baseline gap-2.5 sm:gap-7">
            <span class="text-[16px] sm:text-[32px] font-bold text-stone-900 w-5 sm:w-11 shrink-0 tracking-[-0.5px] tabular-nums leading-none">
              {i + 1}
            </span>
            <p class="text-[15px] sm:text-[22px] font-semibold text-stone-800 leading-[1.55] sm:leading-snug tracking-[-0.5px] sm:tracking-[-0.4px]">
              {demand}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. 피해 제보 CTA -->
  <section class="bg-stone-50 py-20">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-[22px] font-semibold text-stone-800 tracking-[-0.32px] mb-4">
        투표소에서 겪은 일을 제보해주세요
      </h2>
      <div class="space-y-4 text-[15px] text-stone-600 leading-7 tracking-[-0.16px] max-w-xl mb-8">
        <p>
          투표용지 부족, 장시간 대기, 투표 중단, 투표 포기를 겪으셨나요?
        </p>
        <p>
          당신의 제보는 피해지역 분석과 법률 검토의 중요한 근거가 됩니다.<br />
          제보 내용과 첨부자료는 기본적으로 외부에 공개되지 않습니다.
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a
          href="/revote/report"
          class="inline-flex items-center h-10 px-4 text-sm font-medium text-white bg-stone-900 rounded-full hover:bg-stone-700 transition-colors tracking-[-0.14px]"
        >
          피해 제보하기 →
        </a>
        <a
          href="/revote/sign"
          class="inline-flex items-center h-10 px-4 text-sm font-medium text-stone-700 border border-stone-300 rounded-full hover:bg-stone-100 transition-colors tracking-[-0.14px]"
        >
          30초 만에 서명하기 →
        </a>
      </div>
    </div>
  </section>

  <!-- 6. 진행 방식 -->
  <section class="bg-white py-20">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-[22px] font-semibold text-stone-800 tracking-[-0.32px] mb-8">
        어떻게 진행되나요?
      </h2>
      <div class="max-w-xl divide-y divide-stone-200 border-y border-stone-200">
        <div class="py-5 flex gap-5">
          <span class="text-[15px] font-semibold text-stone-400 w-6 shrink-0">1</span>
          <div>
            <p class="text-[15px] font-semibold text-stone-900 tracking-[-0.16px] mb-1">서명</p>
            <p class="text-[15px] text-stone-600 leading-7 tracking-[-0.16px]">
              30초 안에 서명을 완료하고 주변에 공유합니다.
            </p>
          </div>
        </div>
        <div class="py-5 flex gap-5">
          <span class="text-[15px] font-semibold text-stone-400 w-6 shrink-0">2</span>
          <div>
            <p class="text-[15px] font-semibold text-stone-900 tracking-[-0.16px] mb-1">제보</p>
            <p class="text-[15px] text-stone-600 leading-7 tracking-[-0.16px]">
              직접 겪은 피해를 제보하고 사진·영상 등 증거를 업로드합니다.
            </p>
          </div>
        </div>
        <div class="py-5 flex gap-5">
          <span class="text-[15px] font-semibold text-stone-400 w-6 shrink-0">3</span>
          <div>
            <p class="text-[15px] font-semibold text-stone-900 tracking-[-0.16px] mb-1">검증</p>
            <p class="text-[15px] text-stone-600 leading-7 tracking-[-0.16px]">
              운영팀이 제보를 검토하고 미확인 주장과 확인된 사실을 구분합니다.
            </p>
          </div>
        </div>
        <div class="py-5 flex gap-5">
          <span class="text-[15px] font-semibold text-stone-400 w-6 shrink-0">4</span>
          <div>
            <p class="text-[15px] font-semibold text-stone-900 tracking-[-0.16px] mb-1">전달</p>
            <p class="text-[15px] text-stone-600 leading-7 tracking-[-0.16px]">
              수집된 서명과 제보를 정부, 국회, 법원, 정당, 선관위에 공식 전달합니다.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. FAQ -->
  <section class="bg-white py-20">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-[22px] font-semibold text-stone-800 tracking-[-0.32px] mb-8">
        자주 묻는 질문
      </h2>
      <div class="max-w-xl divide-y divide-stone-200 border-y border-stone-200">

        <details class="group py-5">
          <summary class="flex items-center justify-between cursor-pointer list-none text-[15px] font-semibold text-stone-800 tracking-[-0.16px]">
            서명하면 어떤 의미가 있나요?
            <span class="ml-4 shrink-0 text-stone-400 group-open:rotate-180 transition-transform">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </span>
          </summary>
          <p class="mt-3 text-[15px] text-stone-600 leading-7 tracking-[-0.16px]">
            서명은 선거관리 부실에 대한 공식적인 시민의 의사 표시입니다.
            수집된 서명 명부는 정부·국회·선관위 등에 공식 전달됩니다.
            법적 구속력은 없으나 정치적·사회적 압박의 근거가 됩니다.
          </p>
        </details>

        <details class="group py-5">
          <summary class="flex items-center justify-between cursor-pointer list-none text-[15px] font-semibold text-stone-800 tracking-[-0.16px]">
            피해 제보는 어떻게 활용되나요?
            <span class="ml-4 shrink-0 text-stone-400 group-open:rotate-180 transition-transform">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </span>
          </summary>
          <p class="mt-3 text-[15px] text-stone-600 leading-7 tracking-[-0.16px]">
            제보는 피해지역 분석, 법률 검토, 통계 분석의 근거로 활용됩니다.
            운영팀이 검토 후 미확인 주장과 확인된 사실을 구분하며,
            자동으로 공개되지 않습니다.
            법률 검토를 위한 제3자 제공은 별도 동의자에 한해 진행됩니다.
          </p>
        </details>

        <details class="group py-5">
          <summary class="flex items-center justify-between cursor-pointer list-none text-[15px] font-semibold text-stone-800 tracking-[-0.16px]">
            개인정보는 안전한가요?
            <span class="ml-4 shrink-0 text-stone-400 group-open:rotate-180 transition-transform">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </span>
          </summary>
          <p class="mt-3 text-[15px] text-stone-600 leading-7 tracking-[-0.16px]">
            휴대폰 번호는 암호화하여 저장하고, 중복 방지 목적으로만 활용합니다.
            첨부파일은 비공개 저장소에 보관하며 관리자만 접근할 수 있습니다.
            삭제 요청 시 즉시 처리합니다.
          </p>
        </details>

        <details class="group py-5">
          <summary class="flex items-center justify-between cursor-pointer list-none text-[15px] font-semibold text-stone-800 tracking-[-0.16px]">
            이미 서명했는데 중복으로 서명하면 어떻게 되나요?
            <span class="ml-4 shrink-0 text-stone-400 group-open:rotate-180 transition-transform">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </span>
          </summary>
          <p class="mt-3 text-[15px] text-stone-600 leading-7 tracking-[-0.16px]">
            동일한 휴대폰 번호로 재제출 시 "이미 서명에 참여하셨습니다"라고 안내하며
            중복 저장하지 않습니다. 서명 명부의 신뢰도를 지키기 위함입니다.
          </p>
        </details>

        <details class="group py-5">
          <summary class="flex items-center justify-between cursor-pointer list-none text-[15px] font-semibold text-stone-800 tracking-[-0.16px]">
            이 캠페인은 어디서 운영하나요?
            <span class="ml-4 shrink-0 text-stone-400 group-open:rotate-180 transition-transform">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </span>
          </summary>
          <p class="mt-3 text-[15px] text-stone-600 leading-7 tracking-[-0.16px]">
            AIP · AI Party가 운영하는 시민행동 플랫폼입니다.
            문의는 <a href="mailto:revote@aiparty.kr" class="text-stone-900 underline underline-offset-2 hover:text-stone-600">revote@aiparty.kr</a>로 연락주세요.
          </p>
        </details>

      </div>
    </div>
  </section>

  <!-- 9. 하단 CTA -->
  <section class="bg-[#0e0e0d] py-24">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <p class="text-[12px] font-medium text-stone-500 tracking-[0.14em] uppercase mb-6">
        지금 바로 행동하세요
      </p>
      <h2 class="text-[28px] sm:text-[36px] font-semibold text-white leading-[1.3] tracking-[-0.4px] mb-4">
        100만 명의 서명이 모이면,<br />침묵하던 기관들도 답해야 합니다.
      </h2>
      <p class="text-[15px] text-stone-400 leading-7 tracking-[-0.16px] mb-10">
        당신의 서명은 잃어버린 주권을 회복하기 위한 첫 번째 행동입니다.
      </p>
      <div class="flex flex-wrap gap-3 justify-center mb-12">
        <a
          href="/revote/sign"
          class="inline-flex items-center h-10 px-4 text-sm font-medium text-stone-900 bg-white rounded-full hover:bg-stone-200 transition-colors tracking-[-0.14px]"
        >
          30초 만에 서명하기 →
        </a>
        <a
          href="/revote/report"
          class="inline-flex items-center h-10 px-4 text-sm font-medium text-stone-200 border border-stone-600 rounded-full hover:bg-white/10 transition-colors tracking-[-0.14px]"
        >
          피해 제보하기 →
        </a>
      </div>
      <div class="flex justify-center">
        <ShareBar />
      </div>
    </div>
  </section>

</RevoteLayout>

<script type="module" is:inline>
  import { trackReferralVisit, track } from "/revote/revote-client.js";
  trackReferralVisit();
  track("page_view_home");

  document.querySelectorAll('a[href^="/revote/sign"]').forEach((a) =>
    a.addEventListener("click", () => track("click_sign_cta"))
  );
  document.querySelectorAll('a[href^="/revote/report"]').forEach((a) =>
    a.addEventListener("click", () => track("click_report_cta"))
  );
</script>
