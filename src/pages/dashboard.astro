---
import CommunityLayout from '../layouts/CommunityLayout.astro';
---

<CommunityLayout title="발기인 대시보드 | AIP · AI Party" active="dashboard">
  <Fragment slot="head">
    <meta name="description" content="에이아이당 발기인 접수 현황. 전체 발기인 수와 시·도별 참여 인원 및 비율을 확인하세요." />
    <link rel="canonical" href="https://aiparty.kr/dashboard" />
  </Fragment>

  <section id="dashboard" class="c-page">
    <div class="page-heading">
      <p class="eyebrow">AIP / 함께 만드는 시작</p>
      <h1>발기인 대시보드</h1>
      <p class="intro">우리의 시작이 어디까지 닿았는지, 함께 확인하세요.</p>
    </div>

    <div class="toolbar">
      <p id="update-status" role="status" aria-live="polite">접수 현황을 불러오는 중입니다.</p>
      <button id="refresh-stats" type="button" disabled>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M20 7v5h-5M4 17v-5h5" /><path d="M6 7a7 7 0 0 1 12-2l2 7M4 12l2 7a7 7 0 0 0 12-2" /></svg>
        새로고침
      </button>
    </div>

    <div id="stats-error" class="error-panel" role="alert" hidden>
      <p>접수 현황을 불러오지 못했습니다.</p>
      <p>잠시 후 새로고침해 주세요.</p>
    </div>
    <noscript><p class="error-panel">접수 현황을 확인하려면 브라우저에서 JavaScript를 켜 주세요.</p></noscript>

    <section id="stats-content" aria-label="발기인 접수 현황" aria-busy="true">
      <div class="summary-grid">
        <div class="summary-card total-card">
          <h2>전체 발기인</h2>
          <p class="total-number"><span id="stat-total">—</span><span class="unit">명</span></p>
          <p class="card-note">온라인 발기인 동의서 누적 접수</p>
        </div>
      </div>

      <section class="region-panel" aria-labelledby="region-title">
        <div class="panel-heading">
          <div>
            <h2 id="region-title">지역별 참여 비율</h2>
            <p>전체 발기인 중 각 지역이 차지하는 비율입니다.</p>
          </div>
          <label class="sort-control">정렬
            <select id="region-sort" aria-label="지역 정렬">
              <option value="count">참여 많은 순</option>
              <option value="name">가나다순</option>
            </select>
          </label>
        </div>
        <p id="stats-empty" class="empty-state" hidden>아직 접수된 발기인이 없습니다. 첫 번째 시작을 함께해 주세요.</p>
        <div class="region-columns" id="region-columns" hidden>
          {[0, 1].map((index) => (
            <table>
              <caption class="sr-only">지역별 발기인 수와 비율 ({index + 1})</caption>
              <thead><tr><th scope="col">지역</th><th scope="col" class="numeric">인원</th><th scope="col" class="numeric">비율</th></tr></thead>
              <tbody id={`region-body-${index}`}></tbody>
            </table>
          ))}
        </div>
        <p id="regions-loading" class="loading-state">지역별 현황을 확인하고 있습니다.</p>
        <p class="method-note">입력한 주소의 시·도를 기준으로 집계합니다. 분류되지 않는 주소는 ‘기타’에 포함하며, 반올림으로 비율의 합이 100%와 다를 수 있습니다.</p>
      </section>
    </section>

    <div class="participate-banner">
      <p>새로운 시작에 함께해 주세요.</p>
      <a href="/#founding-members">발기인으로 참여하기 <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</CommunityLayout>

<script>
  import { parseFoundingStats, regionPercentage, sortRegions, type FoundingStats } from '../lib/founding-stats';
  import { SUPABASE_URL, SUPABASE_ANON_KEY } from '../lib/supabase';

  const refresh = document.querySelector<HTMLButtonElement>('#refresh-stats')!;
  const sort = document.querySelector<HTMLSelectElement>('#region-sort')!;
  const status = document.querySelector<HTMLElement>('#update-status')!;
  const error = document.querySelector<HTMLElement>('#stats-error')!;
  const content = document.querySelector<HTMLElement>('#stats-content')!;
  const number = new Intl.NumberFormat('ko-KR');
  const percent = new Intl.NumberFormat('ko-KR', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
  const date = new Intl.DateTimeFormat('ko-KR', { timeZone: 'Asia/Seoul', dateStyle: 'medium', timeStyle: 'short' });
  let current: FoundingStats | undefined;

  function setText(id: string, value: string) { document.getElementById(id)!.textContent = value; }
  function renderRegions() {
    if (!current) return;
    const rows = sortRegions(current.regions, sort.value);
    const split = Math.ceil(rows.length / 2);
    [rows.slice(0, split), rows.slice(split)].forEach((group, index) => {
      const body = document.getElementById(`region-body-${index}`)!;
      body.replaceChildren();
      for (const row of group) {
        const tr = document.createElement('tr');
        const label = document.createElement('th');
        label.scope = 'row';
        const bar = document.createElement('span');
        bar.className = 'region-bar';
        bar.style.width = `${regionPercentage(row.count, current!.total)}%`;
        bar.setAttribute('aria-hidden', 'true');
        const name = document.createElement('span');
        name.textContent = row.region;
        label.append(bar, name);
        const count = document.createElement('td');
        count.className = 'numeric';
        count.textContent = `${number.format(row.count)}명`;
        const share = document.createElement('td');
        share.className = 'numeric';
        share.textContent = `${percent.format(regionPercentage(row.count, current!.total))}%`;
        tr.append(label, count, share);
        body.append(tr);
      }
    });
  }

  async function loadStats() {
    refresh.disabled = true;
    content.setAttribute('aria-busy', 'true');
    error.hidden = true;
    status.textContent = '접수 현황을 불러오는 중입니다.';
    try {
      const response = await fetch(`${SUPABASE_URL}/rest/v1/rpc/founding_member_stats`, {
        method: 'POST',
        headers: { apikey: SUPABASE_ANON_KEY, Authorization: `Bearer ${SUPABASE_ANON_KEY}`, 'Content-Type': 'application/json' },
        body: '{}', cache: 'no-store', signal: AbortSignal.timeout(15000),
      });
      if (!response.ok) throw new Error('Statistics unavailable');
      current = parseFoundingStats(await response.json());
      setText('stat-total', number.format(current.total));
      document.getElementById('stats-empty')!.hidden = current.total !== 0;
      document.getElementById('region-columns')!.hidden = false;
      document.getElementById('regions-loading')!.hidden = true;
      renderRegions();
      status.textContent = `${date.format(new Date(current.updated_at))} 기준 · 한국 시간`;
    } catch {
      error.hidden = false;
      document.getElementById('regions-loading')!.hidden = true;
      status.textContent = current ? '업데이트에 실패했습니다. 마지막으로 확인한 현황입니다.' : '집계 현황에 연결하지 못했습니다.';
    } finally {
      refresh.disabled = false;
      content.setAttribute('aria-busy', 'false');
    }
  }
  sort.addEventListener('change', renderRegions);
  refresh.addEventListener('click', loadStats);
  loadStats();
</script>

<style>
  .page-heading { padding-top:0; }
  .eyebrow { font-size:11px;letter-spacing:.04em;color:var(--c-muted);margin-bottom:12px; }
  h1 { font-size:clamp(25px,3vw,30px);line-height:1.3;letter-spacing:-.9px;font-weight:600;text-wrap:balance; }
  .intro { color:var(--c-muted);font-size:14px;margin-top:10px;line-height:1.6; }
  .toolbar { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin: 40px 0 16px; font-size: 12px; color: #78716c; }
  button { display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:40px;padding-inline:12px;border:0;background:rgba(150,156,170,.09);border-radius:8px;color:inherit;cursor:pointer;white-space:nowrap; }
  button:disabled { opacity: .5; cursor: wait; }
  a:focus-visible, button:focus-visible, select:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  a:hover { opacity: .75; }
  .summary-grid { display: grid; grid-template-columns: 1fr; }
  .summary-card { border:1px solid rgba(255,255,255,.65);border-radius:14px;padding:22px;background:var(--c-bg);display:flex;flex-direction:column;min-height:170px;box-shadow:0 2px 8px rgba(27,31,46,.025); }
  .summary-card h2 { font-size: 13px; font-weight: 500; color: #78716c; }
  .total-card { color:var(--c-text); }
  .total-card h2, .total-card .card-note { color:var(--c-muted); }
  .total-number { margin:14px 0 20px;font-size:44px;line-height:1.1;letter-spacing:-1.5px;font-weight:500;font-variant-numeric:tabular-nums; }
  .unit { font-size: 16px; font-weight: 400; letter-spacing: 0; margin-left: 6px; }
  .card-note { font-size: 12px; color: #78716c; margin-top: auto; }
  .region-panel { margin-top:24px;border:1px solid rgba(255,255,255,.65);border-radius:14px;padding:24px;background:var(--c-bg);box-shadow:0 2px 8px rgba(27,31,46,.025); }
  .panel-heading { display: flex; justify-content: space-between; align-items: center; gap: 20px; }
  .panel-heading h2 { font-size: 18px; font-weight: 600; letter-spacing: -.45px; }
  .panel-heading p { margin-top: 8px; color: #78716c; font-size: 13px; line-height: 1.6; }
  .sort-control { font-size: 12px; display: flex; align-items: center; gap: 10px; white-space: nowrap; color: #78716c; }
  select { background: transparent; color: inherit; border: 1px solid #d6d3d1; border-radius: 8px; min-height: 40px; padding: 8px; cursor: pointer; }
  .region-columns { display: grid; grid-template-columns: 1fr 1fr; column-gap: 48px; margin-top: 28px; }
  [hidden] { display: none !important; }
  table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 13px; }
  thead { color: #78716c; font-size: 11px; }
  th { font-weight: 400; text-align: left; }
  th:first-child { width: 46%; }
  thead th { padding: 0 8px 12px; border-bottom: 1px solid #e7e5e4; }
  .region-columns :global(tbody th), .region-columns :global(tbody td) { position: relative; padding: 16px 8px; border-bottom: 1px solid #f5f5f4; }
  .region-columns :global(tbody th) { text-align: left; font-weight: 400; }
  .region-columns :global(tbody th > span:last-child) { position: relative; }
  .region-columns :global(.region-bar) { position: absolute; left: 0; top: 11px; height: calc(100% - 22px); background: #e7e5e4; border-radius: 4px; }
  .numeric { text-align: right; font-variant-numeric: tabular-nums; }
  .region-columns :global(td.numeric) { text-align: right; font-variant-numeric: tabular-nums; }
  .method-note { border-top: 1px solid #e7e5e4; padding-top: 18px; margin-top: 24px; font-size: 11px; line-height: 1.8; color: #78716c; }
  .empty-state, .loading-state { padding: 48px 0 24px; color: #78716c; font-size: 14px; text-align: center; }
  .error-panel { background: #fef2f2; border: 1px solid #fecaca; border-radius: 12px; padding: 16px 20px; margin-bottom: 16px; color: #991b1b; font-size: 13px; line-height: 1.8; }
  .participate-banner { margin-top: 32px; padding: 24px 0; display: flex; justify-content: space-between; align-items: center; gap: 20px; font-size: 14px; }
  .participate-banner a { border-bottom: 1px solid currentColor; padding-bottom: 4px; font-weight: 500; }
  footer { display: flex; justify-content: space-between; gap: 20px; padding: 28px 0 80px; margin-top: 16px; border-top: 1px solid #e7e5e4; font-size: 11px; color: #78716c; }
  .skip-link { position: fixed; top: -100px; left: 20px; z-index: 200; padding: 12px; background: #222; color: white; }
  .skip-link:focus { top: 12px; }
  :global(.dark) .summary-card, :global(.dark) .region-panel, :global(.dark) thead th, :global(.dark) .method-note { border-color:var(--c-border); }
  :global(.dark) .region-columns :global(tbody th), :global(.dark) .region-columns :global(tbody td) { border-color: #23252a; }
  :global(.dark) .region-columns :global(.region-bar) { background: #34343a; }
  :global(.dark) .intro, :global(.dark) .eyebrow, :global(.dark) .toolbar, :global(.dark) .summary-card h2, :global(.dark) .card-note, :global(.dark) .panel-heading p, :global(.dark) .sort-control, :global(.dark) thead, :global(.dark) .method-note, :global(.dark) .empty-state, :global(.dark) .loading-state, :global(.dark) footer { color: #a8a29e; }
  :global(.dark) .total-card h2, :global(.dark) .total-card .card-note { color:var(--c-muted); }
  :global(.dark) select, :global(.dark) button, :global(.dark) .join-link { border-color: #57534e; }
  :global(.dark) select option { background: #141516; }
  :global(.dark) .error-panel { background: #291515; border-color: #7f1d1d; color: #fecaca; }
  @media (max-width: 720px) {
    .page-heading { padding-top:0; }
    .toolbar { margin-top: 28px; align-items: flex-start; }
    .toolbar p { line-height: 1.8; }
    .summary-card { padding: 20px; min-height: 170px; }
    .total-card { min-height:164px; }
    .total-number { font-size: 52px; }
    .region-panel { padding: 20px; }
    .panel-heading { align-items: flex-start; flex-direction: column; }
    .region-columns { grid-template-columns: 1fr; row-gap: 20px; }
    .participate-banner, footer { align-items: flex-start; flex-direction: column; gap: 12px; }
    footer { padding-bottom: 90px; }
  }
</style>
