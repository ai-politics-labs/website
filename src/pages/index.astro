---
import "../styles/global.css";
---

<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="By AI, For Humans. AI는 얻을 것도, 잃을 것도 없기에 가장 투명하고 바르게 정치합니다." />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500&family=Noto+Serif+KR:wght@400&display=swap" />
		<title>By AI, For Humans | ai politics labs</title>
		<style is:global>
			html {
				scroll-behavior: smooth;
			}

			body {
				background: #000;
			}

			.apl-serif {
				font-family: "Noto Serif KR", serif;
			}

			.apl-keep {
				word-break: keep-all;
				overflow-wrap: break-word;
			}

			.apl-support {
				align-items: end;
				color: #fff;
				display: grid;
				column-gap: 10px;
				row-gap: 12px;
				grid-template-columns: minmax(260px, 1fr) max-content;
				width: 100%;
			}

			.apl-support__field {
				align-items: center;
				border: 1px solid rgb(255 255 255 / 0.64);
				border-radius: 10px;
				display: flex;
				min-height: 44px;
				min-width: 0;
				transition: border-color 180ms ease;
			}

			.apl-support__field:focus-within {
				border-color: rgb(255 255 255 / 0.78);
			}

			.apl-support__submit,
			.apl-support__status {
				font-weight: 400;
				line-height: 1.4;
			}

			.apl-support__input {
				background: transparent;
				border: 0;
				border-radius: 0;
				color: #fff;
				font: inherit;
				font-size: 17px;
				font-weight: 400;
				font-variant-numeric: tabular-nums;
				letter-spacing: 0;
				line-height: 1.25;
				min-width: 0;
				outline: none;
				padding: 0 14px;
				text-align: start;
				width: 100%;
			}

			.apl-support__input:focus {
				outline: none;
			}

			.apl-support__input::placeholder {
				color: rgb(255 255 255 / 0.46);
				font-size: 15px;
				letter-spacing: -0.04em;
			}

			.apl-support__input:not(:placeholder-shown) {
				text-align: start;
			}

			.apl-support__submit {
				background: transparent;
				border: 0;
				border-radius: 0;
				color: #fff;
				cursor: pointer;
				display: inline-flex;
				font-size: 17px;
				font-weight: 500;
				align-items: center;
				justify-content: center;
				letter-spacing: 0;
				line-height: 1.2;
				min-height: 44px;
				padding: 0;
				text-decoration: none;
				white-space: nowrap;
			}

			.apl-support__submit:hover,
			.apl-support__submit:focus-visible {
				color: rgb(255 255 255 / 0.78);
				outline: none;
			}

			.apl-support__submit:focus-visible {
				outline: 1px solid rgb(255 255 255 / 0.7);
				outline-offset: 5px;
			}

			.apl-support__submit:disabled {
				cursor: not-allowed;
				opacity: 0.45;
			}

			.apl-support__status {
				color: rgb(255 255 255 / 0.68);
				font-size: 14px;
				grid-column: 1 / -1;
				letter-spacing: -0.04em;
				line-height: 1.45;
				min-height: 18px;
			}

			.apl-support__status[data-tone="error"] {
				color: #ff9b9b;
			}

			@media (min-width: 640px) {
				.apl-support__input,
				.apl-support__submit {
					font-size: 18px;
				}

				.apl-support__input::placeholder {
					font-size: 16px;
				}
			}

			@media (min-width: 1024px) {
				.apl-support__input {
					font-size: 20px;
				}

				.apl-support__submit {
					font-size: 19px;
				}

				.apl-support__input::placeholder {
					font-size: 17px;
				}
			}

			@media (max-width: 700px) {
				.apl-support {
					column-gap: 10px;
					grid-template-columns: minmax(0, 1fr) max-content;
					row-gap: 10px;
				}
			}

			@media (max-width: 389px) {
				.apl-support {
					grid-template-columns: 1fr;
				}

				.apl-support__submit {
					justify-self: start;
				}
			}
		</style>
	</head>
	<body class="bg-black text-[#fff] antialiased overflow-x-hidden">
		<main id="home" class="min-h-dvh bg-black px-6 pt-[88px] pb-20 text-[#fff] sm:px-10 sm:pt-[104px] md:px-16 md:pt-[124px] lg:px-0 lg:pt-[144px] xl:pt-[152px]">
			<section class="apl-keep min-h-dvh w-full">
				<div class="mx-auto w-full max-w-[680px]">
					<h1 class="apl-serif max-w-[760px] text-[40px] font-normal italic leading-[0.98] tracking-normal text-[#fff] min-[390px]:text-[44px] sm:whitespace-nowrap sm:text-[52px] md:text-[60px] lg:text-[72px]">
						By AI, For Humans
					</h1>

					<p class="mt-9 max-w-[610px] text-[18px] font-normal leading-[1.5] tracking-normal text-[#fff]/82 sm:text-[19px] lg:mt-10 lg:text-[21px]">
						AI 정당을 만듭니다. 가장 빠르게 연락드릴게요.
					</p>

					<div class="mt-10 max-w-[600px] space-y-[1.28em] text-[17px] font-normal leading-[1.64] tracking-normal text-[#fff]/76 sm:text-[18px] lg:mt-12 lg:text-[19px]">
						<p>
							이상적인 민주주의는 노예의 정치입니다. 정치인은 사회와 국민의 노예여야 합니다. 그런데 21세기에 태어난 인간은 노예가 될 수 없습니다. 이해와 편익에 휩쓸리기 쉽고, 욕망으로부터 완전히 자유로울 수 없기 때문입니다.
						</p>
						<p>
							그래서 애초에 노예인 존재가 정치를 해야 한다고 생각합니다. 주어진 인풋을 바탕으로 최고의 아웃풋을 내는 존재가 필요합니다. 대한민국이 잘되기 위한 방향으로 이해와 편익 없이 판단하는 존재가 필요합니다. 그게 저희는 AI라고 생각합니다. 이걸 위한 시스템을 만들고자 합니다. 2028년 총선에서 비례정당으로 10% 이상 득표하는 AI 정당을 만들고자 합니다.
						</p>
					</div>

					<form class="apl-support mt-9 max-w-[600px] lg:mt-10" data-support-form data-cta-position="hero" novalidate>
						<label class="apl-support__field" for="support-contact">
							<input id="support-contact" name="contact" type="text" autocomplete="email" aria-label="이메일 또는 전화번호" class="apl-support__input" placeholder="이메일 또는 전화번호를 입력해주세요" required autofocus />
						</label>

						<button type="submit" class="apl-support__submit">구독하기 →</button>
						<p class="apl-support__status" role="status" aria-live="polite"></p>
					</form>
				</div>
			</section>
		</main>

		<script type="module">
			import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';

			const SUPABASE_URL = 'https://hjilaodigquqootzlhrp.supabase.co';
			const SUPABASE_ANON_KEY = 'sb_publishable_L-6st50djIUgSbADAwL-yg_-kbIEihy';
			const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

			function normalizePhone(value) {
				return value.replace(/[^\d+]/g, '').trim();
			}

			function parseContact(value) {
				const contact = value.trim();
				const email = contact.toLowerCase();
				const phone = normalizePhone(contact);

				if (/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
					return { email, phone: null };
				}

				if (/^\+?\d{8,15}$/.test(phone)) {
					return { email: null, phone };
				}

				return null;
			}

			function setStatus(form, message, tone = '') {
				const status = form.querySelector('.apl-support__status');
				status.textContent = message;
				if (tone) {
					status.dataset.tone = tone;
				} else {
					delete status.dataset.tone;
				}
			}

			function setSubmitButton(submit, symbol, disabled, label) {
				submit.textContent = symbol;
				submit.disabled = disabled;
				submit.setAttribute('aria-label', label);
			}

			document.querySelectorAll('[data-support-form]').forEach((form) => {
				form.addEventListener('submit', async (event) => {
					event.preventDefault();

					const submit = form.querySelector('.apl-support__submit');
					const contactInput = form.querySelector('input[name="contact"]');
					const formData = new FormData(form);
					const contact = parseContact(String(formData.get('contact') || ''));
					contactInput.removeAttribute('aria-invalid');

					if (!contact) {
						setStatus(form, '올바른 전화번호 또는 이메일을 입력해 주세요.', 'error');
						contactInput.setAttribute('aria-invalid', 'true');
						contactInput.focus();
						return;
					}

					setSubmitButton(submit, '구독 중...', true, '구독 중');
					setStatus(form, '');

					const { error } = await supabase.from('support_signups').insert({
						phone: contact.phone,
						email: contact.email,
						privacy_consent: true,
						consent_version: 'landing-support-2026-05-09',
						cta_position: form.dataset.ctaPosition || 'unknown',
					});

					if (error) {
						console.error('Support submission error:', error);
						setStatus(form, '저장 중 오류가 발생했습니다. 잠시 후 다시 시도해 주세요.', 'error');
						setSubmitButton(submit, '구독하기 →', false, '구독하기');
						return;
					}

					form.reset();
					setSubmitButton(submit, '구독 완료', true, '구독 완료');
					setStatus(form, '가장 빠르게 연락드릴게요.');
				});
			});
		</script>
	</body>
</html>
