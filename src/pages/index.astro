---
import Layout from "../layouts/Layout.astro";
import publicFounders from "../data/public-founders.json";

const toc = [
	{ id: "system", label: "01 지금의 대한민국" },
	{ id: "vision", label: "02 왜 바뀌지 않을까요" },
	{ id: "platform", label: "03 우리가 없앨 장애물" },
	{ id: "axis", label: "04 기술에는 좌우가 없습니다" },
	{ id: "people", label: "05 이 정당을 만드는 사람들" },
	{ id: "join", label: "06 함께 바꿔봅시다" },
];

// 얼굴 이미지를 받은 뒤 프로필을 재확인하고 공개합니다.
const showOrganizerProfiles = false;
// 2026-10-09 Supabase 조회: 공개 동의 발기인의 마스킹 이름과 사용자 요청에 따른 등록 직업입니다.
const organizers = publicFounders.map(person => ({
	name: person.name,
	photo: "",
	work: person.occupation,
	achievement: "",
	obstacle: "",
}));
const organizerTotal = organizers.length;
---

<Layout title="AIP · AI Party | 연구자와 창업가가 제대로 대우받는 나라" bodyClass="luma-shell luma-home antialiased overflow-x-hidden">
	<Fragment slot="head">
		<meta name="description" content="AI 시대, 대한민국이 살아남을 수 있을까요? 우리는 그 답이 창업과 연구에 있다고 믿습니다. 연구자와 창업가가 제대로 대우받는 나라, 자기만의 길을 가는 사람도 성공하는 나라를 만듭니다." />
		<link rel="canonical" href="https://aiparty.kr/" />
		<link rel="dns-prefetch" href="https://t1.daumcdn.net" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://aiparty.kr/" />
		<meta property="og:title" content="AIP · AI Party | 연구자와 창업가가 제대로 대우받는 나라" />
		<meta property="og:description" content="연구자와 창업가가 제대로 대우받는 나라. 자기만의 길을 가는 사람도 성공하는 나라를 만듭니다." />
		<meta property="og:image" content="https://aiparty.kr/og-main-v2.png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:site_name" content="AIP · AI Party" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="AIP · AI Party | 연구자와 창업가가 제대로 대우받는 나라" />
		<meta name="twitter:description" content="연구자와 창업가가 제대로 대우받는 나라. 자기만의 길을 가는 사람도 성공하는 나라를 만듭니다." />
		<meta name="twitter:image" content="https://aiparty.kr/og-main-v2.png" />
	</Fragment>

	<a href="#system" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[60] focus:bg-stone-900 dark:focus:bg-stone-100 focus:text-white dark:focus:text-stone-900 focus:px-4 focus:py-2 focus:rounded-full focus:text-sm">본문으로 건너뛰기</a>

	<!-- 상단 바 -->
	<header class="c-header home-header">
		<div class="c-nav-inner home-nav-inner">
			<a href="/" class="c-brand"><img src="/favicon.svg" width="28" height="28" alt="" />AIP · AI Party</a>
			<nav aria-label="커뮤니티" class="c-nav home-nav">
				<button id="toc-toggle" type="button" class="home-toc-toggle" aria-label="목차 열기" aria-expanded="false" aria-controls="toc-overlay">소개 <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></button>
				<a href="/dashboard">발기인 현황</a>
				<a href="/auth" data-community-auth>로그인</a>
			</nav>
		</div>
		<nav id="toc-overlay" aria-label="소개 목차" class="hidden home-toc">
			{toc.map((item) => (
				<a href={`#${item.id}`} class="toc-link">{item.label}</a>
			))}
		</nav>
	</header>

	<main class="home-content">
		<aside data-referral-invite hidden class="bg-stone-100 dark:bg-white/5 border-b border-stone-200 dark:border-white/10 px-6 py-5">
			<div class="max-w-4xl mx-auto flex flex-wrap items-center justify-between gap-4">
				<div><p class="text-[15px] font-medium">연구자와 창업가가 제대로 대우받는 나라.</p><p class="text-[12px] text-stone-500 dark:text-stone-400 mt-1">자기만의 길을 가는 사람도 성공하는 나라를 만듭니다.</p></div>
					<a href="#founding-members" class="c-button">발기인 되기</a>
			</div>
		</aside>

		<section id="brief">
			<div class="max-w-4xl mx-auto px-6">
				<h1 class="font-semibold mb-8 text-stone-800 dark:text-stone-300 leading-[1.35] tracking-[-0.7px] text-balance">AI 시대, 대한민국이 살아남을 수 있을까요?</h1>
				<div class="space-y-5 text-[16px] text-stone-600 dark:text-stone-400 leading-8 tracking-[-0.16px] max-w-xl">
					<p>우리는 그 답이 창업과 연구에 있다고 믿습니다.</p>
					<p class="text-stone-800 dark:text-stone-300 font-medium">연구자와 창업가가 제대로 대우받는 나라.</p>
					<p>자기만의 길을 가는 사람도 성공하는 나라를 만듭니다.</p>
				</div>
				<div class="mt-9 flex flex-wrap gap-3">
					<a href="#founding-members" class="inline-flex items-center min-h-11 px-4 text-sm font-medium text-stone-900 bg-white rounded-full hover:bg-stone-200 transition-colors tracking-[-0.14px]">발기인 되기</a>
					<a href="https://calendar.app.google/A6wYKXx7pB5wrigd8" target="_blank" rel="noopener noreferrer" class="inline-flex items-center min-h-11 px-4 text-sm font-medium text-stone-200 border border-stone-600 rounded-full hover:bg-white/10 transition-colors tracking-[-0.14px]">커피챗 하기</a>
				</div>
			</div>
		</section>

		<section id="system" class="mt-24">
			<div class="max-w-4xl mx-auto px-6">
				<h2 class="font-semibold mb-8 text-[28px] sm:text-[36px] text-stone-900 dark:text-stone-100 leading-[1.3] tracking-[-0.32px] text-balance">지금의 대한민국</h2>
				<div class="space-y-5 text-[16px] text-stone-600 dark:text-stone-400 leading-8 tracking-[-0.16px] max-w-xl">
					<p class="text-stone-900 dark:text-stone-100 font-medium">남들이 가라는 길로 가야 안전한 나라.</p>
					<p>가장 똑똑한 학생은 연구실 대신 의대를 고릅니다.<br/>논문을 잘 써도, 연구를 열심히 해도 달라지는 게 없으니까요.</p>
					<p>창업가는 시장보다 규제를 먼저 공부합니다.<br/>그러다 결국 한국이 아니라 미국에 법인을 냅니다.</p>
					<p class="text-stone-900 dark:text-stone-100 font-medium">이 나라에서 자기 길을 가는 건 손해입니다.</p>
				</div>
			</div>
		</section>

		<section id="vision" class="mt-24">
			<div class="max-w-4xl mx-auto px-6">
				<h2 class="text-[28px] sm:text-[36px] font-semibold text-stone-800 dark:text-stone-300 leading-[1.3] tracking-[-0.32px] mb-8 text-balance">왜 바뀌지 않을까요</h2>
				<div class="space-y-5 text-[16px] text-stone-600 dark:text-stone-400 leading-8 tracking-[-0.16px] max-w-xl">
					<p class="text-stone-800 dark:text-stone-300 font-medium">연구자와 창업가의 목소리가<br/>국회에 닿지 않기 때문입니다.</p>
					<p>정책 토론회는 보통 평일 오후 3시에 열립니다.<br/>열심히 자기 삶을 사는 사람은 갈 수 없는 시간입니다.</p>
					<p>22대 총선 당선인 300명 중<br/>과학기술·IT 분야 출신은 7명, 약 2%입니다.<br/>법조인 출신은 61명입니다. <sup><a href="#source-1" class="underline underline-offset-2" aria-label="국회 구성 통계 출처 보기">[1]</a></sup></p>
					<p>기술을 모르는 사람들이 기술의 규칙을 정합니다.<br/>그래서 R&D 예산은 하루아침에 깎이고,<br/>새로 생긴 규제 하나에 스타트업이 문을 닫습니다.</p>
				</div>
			</div>
		</section>

		<section id="platform" class="mt-24 bg-stone-50 dark:bg-white/[0.03] py-20">
			<div class="max-w-4xl mx-auto px-6">
				<h2 class="text-[28px] sm:text-[36px] font-semibold text-stone-800 dark:text-stone-300 leading-[1.3] tracking-[-0.32px] mb-8 text-balance">우리가 없앨 장애물</h2>
				<ul class="max-w-xl space-y-2 text-[16px] text-stone-600 dark:text-stone-400 leading-8 tracking-[-0.16px]">
					<li>한 해 만에 잘리는 연구 예산.</li>
					<li>현장이 아니라 유행을 따라가는 정부 과제.</li>
					<li>열악한 환경에서 노예처럼 연구하는 대학원생 처우.</li>
					<li>창업할 거면 자퇴하라는 창업휴학 제한.</li>
					<li>사업을 시작조차 할 수 없게 만드는 규제.</li>
				</ul>
				<div class="mt-8 space-y-5 text-[16px] text-stone-600 dark:text-stone-400 leading-8 tracking-[-0.16px] max-w-xl">
					<p class="text-stone-800 dark:text-stone-300 font-medium">우리는 이미 장애물을 치우기 시작했습니다.</p>
					<p>창업휴학 제한을 풀기 위해<br/>각 대학 창업동아리들과 함께 요청하고 있습니다.</p>
				</div>
			</div>
		</section>

		<section id="axis" class="mt-24">
			<div class="max-w-4xl mx-auto px-6">
				<h2 class="text-[28px] sm:text-[36px] font-semibold text-stone-800 dark:text-stone-300 leading-[1.3] tracking-[-0.32px] mb-8 text-balance">기술에는 좌우가 없습니다</h2>
				<div class="space-y-5 text-[16px] text-stone-600 dark:text-stone-400 leading-8 tracking-[-0.16px] max-w-xl">
					<p>R&D 예산 삭감에 반대한다고 진보가 아닙니다.<br/>규제를 풀자고 이야기한다고 보수도 아닙니다.</p>
					<p>연구자와 창업가에게 필요한 건<br/>진영이 아니라 길입니다.</p>
					<p class="text-stone-800 dark:text-stone-300 font-medium">우리는 그 길을 막는 것들을 부수겠습니다.</p>
				</div>
			</div>
		</section>

		<section id="people" class="mt-24 bg-stone-50 dark:bg-white/[0.03] py-20">
			<div class="max-w-4xl mx-auto px-6">
				<h2 class="text-[28px] sm:text-[36px] font-semibold text-stone-800 dark:text-stone-300 leading-[1.3] tracking-[-0.32px] mb-8 text-balance">이 정당을 만드는 사람들</h2>
				<div class="space-y-5 text-[16px] text-stone-600 dark:text-stone-400 leading-8 tracking-[-0.16px] max-w-xl">
					<p>대한민국에서 가장 뛰어난 사람들은<br/>지금 논문을 쓰고, 제품을 만들고 있습니다.</p>
					<p>이제 그 사람들이 나라의 규칙을 만들 차례입니다.</p>
					<p class="text-stone-800 dark:text-stone-300 font-medium">AIP는 직접 창업하고 연구해본 사람들이 만듭니다.</p>
				</div>
				{showOrganizerProfiles && organizers.length > 0 && (
					<div class="organizer-carousel" role="region" aria-roledescription="캐러셀" aria-label="정당을 만드는 사람들">
						{organizers.length > 1 && (
							<div class="organizer-controls">
								<button id="organizer-prev" type="button" class="organizer-scroll-button" aria-label="이전 프로필 보기" aria-controls="organizer-profiles" disabled>
									<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m14 6-6 6 6 6" /></svg>
								</button>
								<button id="organizer-next" type="button" class="organizer-scroll-button" aria-label="다음 프로필 보기" aria-controls="organizer-profiles">
									<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m10 6 6 6-6 6" /></svg>
								</button>
							</div>
						)}
						<ul id="organizer-profiles" class="organizer-track" tabindex="0" aria-label="프로필 카드, 좌우 방향키로 넘길 수 있습니다">
							{organizers.map((person) => (
								<li>
									<article class="organizer-card">
										<div class="organizer-heading">
											{person.photo
												? <img src={person.photo} alt={person.name} width="64" height="64" loading="lazy" class="organizer-photo" />
												: <div class="organizer-photo organizer-photo-empty" aria-hidden="true"></div>}
											<div><h3>{person.name}</h3><p class="organizer-member-label">{person.work || "발기인"}</p></div>
										</div>
										{person.achievement && (
											<dl class="organizer-details">
												{person.achievement && <div><dt>해낸 것</dt><dd>{person.achievement}</dd></div>}
											</dl>
										)}
										{person.obstacle && <><p class="organizer-obstacle-label">내가 없애고 싶은 장애물</p><blockquote>“{person.obstacle}”</blockquote></>}
									</article>
								</li>
							))}
						</ul>
					</div>
				)}
				{showOrganizerProfiles && organizerTotal > 0 && <p class="mt-8 text-[15px] text-stone-600 dark:text-stone-400">공개 동의한 발기인 <strong class="text-stone-900 dark:text-stone-100">{organizerTotal}명</strong></p>}
			</div>
		</section>

		<section id="join" class="mt-24 bg-[#1a1a1a] py-20">
			<div class="max-w-4xl mx-auto px-6">
				<h2 class="text-[28px] sm:text-[36px] font-semibold text-white leading-[1.3] tracking-[-0.32px] mb-8 text-balance">함께 바꿔봅시다</h2>
				<div class="space-y-5 text-[16px] text-stone-300 leading-8 tracking-[-0.16px] max-w-xl">
					<p class="text-white font-medium">2028년 총선,<br/>연구자와 창업가들이 직접 국회에 들어갑니다.</p>
					<p>발기인에게는 당비도, 행사 참석 의무도 없습니다.</p>
					<p>R&D 삭감에 반대하는 것만큼<br/>당연한 일에 이름 하나 보태는 겁니다.</p>
				</div>
				<div class="mt-9 flex flex-wrap gap-3">
					<a href="#founding-members" class="inline-flex items-center min-h-11 px-4 text-sm font-medium text-stone-900 bg-white rounded-full hover:bg-stone-200 transition-colors tracking-[-0.14px]">발기인 되기</a>
					<a href="https://calendar.app.google/A6wYKXx7pB5wrigd8" target="_blank" rel="noopener noreferrer" class="inline-flex items-center min-h-11 px-4 text-sm font-medium text-stone-200 border border-stone-600 rounded-full hover:bg-white/10 transition-colors tracking-[-0.14px]">커피챗 하기</a>
				</div>
			</div>
		</section>

		<section id="founding-members" class="mt-24 pt-10">
			<div class="max-w-4xl mx-auto px-6">
				<h2 class="font-semibold mb-[10px] text-[32px] text-stone-800 dark:text-stone-300 leading-[40px] tracking-[-0.32px]">
					발기인 동의서
				</h2>
				<p class="text-[15px] text-stone-500 dark:text-stone-400 leading-6 tracking-[-0.16px] max-w-xl">
					에이아이당(가칭) 창당준비위원회 발기인에 동의합니다.<br/>
					동의서를 제출하면 사이트 계정도 함께 만들어집니다.<br/>이메일 인증 후 나의 초대 현황을 이용할 수 있습니다.
				</p>
				<a href="/dashboard" class="inline-flex items-center min-h-10 mt-3 text-[13px] text-stone-700 dark:text-stone-300 underline underline-offset-4">전체 발기인 수와 지역별 참여 현황 보기 →</a>

				<div class="mt-6 bg-stone-50 dark:bg-white/[0.03] border border-stone-200 dark:border-white/10 rounded-xl p-5 sm:p-6 space-y-2.5">
					<p class="text-[14px] text-stone-700 dark:text-stone-300 tracking-[-0.14px]"><span class="font-semibold text-stone-800 dark:text-stone-300">발기인이란?</span> 새로운 정당의 시작을 응원해 주신다는 상징적인 의미입니다.</p>
					<ul class="space-y-1.5 text-[13px] text-stone-600 dark:text-stone-400 leading-[20px] tracking-[-0.14px]">
						<li><span class="font-medium text-stone-700 dark:text-stone-300">부담 ZERO :</span> 당비 납부, 행사 참석 의무가 전혀 없습니다.</li>
						<li><span class="font-medium text-stone-700 dark:text-stone-300">정보 보호 :</span> 발기인 서류와 계정 정보를 구분해 관리하며, 실명·주소·서명은 다른 회원에게 공개하지 않습니다.</li>
						<li><span class="text-amber-700">⚠️</span> <span class="font-medium text-stone-700 dark:text-stone-300">가입 불가 :</span> 정당법에 따라 현직 공무원, 교원, 군인, 사회복무요원 등 <span class="text-[12px] text-stone-500 dark:text-stone-400">(산업기능요원·전문연구요원은 가능)</span></li>
					</ul>
				</div>
			</div>
		</section>

		<section class="mt-12 founder-form-section">
			<div class="max-w-4xl mx-auto px-6">
				<p id="founder-form-loading" class="c-message" role="status">가입 양식을 준비하고 있습니다. 계속 이 문구가 보이면 인터넷 연결을 확인하고 새로고침해 주세요.</p>
				<noscript><p class="c-message is-error">안전한 발기인 동의와 계정 생성을 위해 브라우저의 JavaScript를 켜고 새로고침해 주세요.</p></noscript>
				<form id="founding-member-form" method="post" inert novalidate aria-busy="true">
					<div class="founder-card bg-stone-100 dark:bg-white/[0.03] rounded-2xl p-6 sm:p-8 space-y-5">
						<fieldset id="founder-account-fields" class="founder-account-fields">
							<legend class="founder-fieldset-title">로그인할 계정</legend>
							<p class="c-help">발기인 동의와 사이트 가입을 한 번에 진행합니다. 이미 계정이 있다면 <a href="/auth?next=%2F%23founding-members" class="c-link">로그인</a> 후 동의서만 제출해 주세요.</p>
							<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
								<div class="c-field sm:col-span-2">
									<label for="signup-username">아이디 <span class="text-red-500" aria-hidden="true">*</span></label>
