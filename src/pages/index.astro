		<meta property="og:description" content="AI는 얻을 것도, 잃을 것도 없기에 가장 투명하고 바르게 정치합니다." />
		<meta property="og:image" content="https://aipoliticslabs.com/og-main.png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:site_name" content="ai politics labs" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="By AI, For Humans | ai politics labs" />
		<meta name="twitter:description" content="AI는 얻을 것도, 잃을 것도 없기에 가장 투명하고 바르게 정치합니다." />
		<meta name="twitter:image" content="https://aipoliticslabs.com/og-main.png" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500&family=Noto+Serif+KR:wght@400&display=swap" />
		<title>By AI, For Humans | ai politics labs</title>
		<style is:global>
			html {
				scroll-behavior: smooth;
			}

			body {
				background: #000;
			}

			.apl-serif {
				font-family: "Noto Serif KR", serif;
			}

			.apl-keep {
				word-break: keep-all;
				overflow-wrap: break-word;
			}

			.apl-support {
				align-items: flex-start;
				color: #FFF0DF;
				column-gap: 14px;
				display: grid;
				grid-template-columns: auto minmax(0, 1fr);
				row-gap: 10px;
				width: 100%;
			}

			.apl-support__summary {
				display: inline-flex;
				flex: 0 0 auto;
				cursor: pointer;
				font-size: 19px;
				font-weight: 500;
				letter-spacing: -0.06em;
				line-height: 1.1;
				list-style: none;
				text-decoration-color: rgb(255 240 223 / 0.8);
				text-decoration-line: underline;
				text-decoration-thickness: 1px;
				text-underline-offset: 6px;
				transition: color 180ms ease, text-decoration-color 180ms ease;
			}

			.apl-support__summary:hover {
				color: rgb(255 240 223 / 0.78);
				text-decoration-color: rgb(255 240 223 / 0.5);
			}

			.apl-support__summary:focus-visible {
				outline: 1px solid rgb(255 240 223 / 0.75);
				outline-offset: 5px;
			}

			.apl-support__summary::-webkit-details-marker {
				display: none;
			}

			.apl-support__summary::marker {
				content: "";
			}

			.apl-support__label--open {
				display: none;
			}

			.apl-support[open] .apl-support__label--closed {
				display: none;
			}

			.apl-support[open] .apl-support__label--open {
				display: inline;
			}

			.apl-support__form {
				animation: apl-support-reveal 180ms ease both;
				display: grid;
				gap: 12px;
				margin-top: 0;
				max-width: 430px;
				min-width: 0;
				overflow: clip;
				transform-origin: top left;
			}

			@keyframes apl-support-reveal {
				from {
					opacity: 0;
					transform: translateY(-4px);
				}

				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

			.apl-support__entry {
				align-items: end;
				display: grid;
				gap: 12px;
				grid-template-columns: minmax(0, 1fr) auto;
			}

			.apl-support__field {
				border-bottom: 1px solid rgb(255 240 223 / 0.32);
				display: grid;
				gap: 2px;
				min-width: 0;
				transition: border-color 180ms ease;
			}

			.apl-support__field:focus-within {
				border-bottom-color: rgb(255 240 223 / 0.78);
			}

			.apl-support__field-label {
				color: rgb(255 240 223 / 0.42);
				font-size: 12px;
				font-weight: 500;
				letter-spacing: -0.04em;
				line-height: 1.15;
			}

			.apl-support__consent,
			.apl-support__submit,
			.apl-support__status {
				font-size: 13px;
				font-weight: 400;
				letter-spacing: -0.04em;
				line-height: 1.4;
			}

			.apl-support__input {
				background: transparent;
				border: 0;
				border-radius: 0;
				color: #FFF0DF;
				font: inherit;
				font-size: 16px;
				font-weight: 400;
				letter-spacing: -0.04em;
				line-height: 1.25;
				min-width: 0;
				outline: none;
				padding: 3px 0 8px;
				width: 100%;
			}

			.apl-support__input:focus {
				outline: none;
			}

			.apl-support__input::placeholder {
				color: rgb(255 240 223 / 0.24);
			}

			.apl-support__consent {
				align-items: flex-start;
				color: rgb(255 240 223 / 0.58);
				display: flex;
				gap: 7px;
				max-width: 430px;
				overflow-wrap: break-word;
				word-break: keep-all;
			}

			.apl-support__checkbox {
				accent-color: #FFF0DF;
				flex: 0 0 auto;
				height: 13px;
				margin-top: 3px;
				width: 13px;
			}

			.apl-support__checkbox:focus-visible {
				outline: 1px solid rgb(255 240 223 / 0.7);
				outline-offset: 3px;
			}

			.apl-support__submit {
				background: transparent;
				border: 0;
				color: #FFF0DF;
				cursor: pointer;
				font-size: 16px;
				line-height: 1;
				padding: 0 0 7px;
				text-decoration-color: rgb(255 240 223 / 0.8);
				text-decoration-line: underline;
				text-decoration-thickness: 1px;
				text-underline-offset: 5px;
				white-space: nowrap;
			}

			.apl-support__submit:hover,
			.apl-support__submit:focus-visible {
				color: rgb(255 240 223 / 0.78);
				outline: none;
				text-decoration-color: rgb(255 240 223 / 0.5);
			}

			.apl-support__submit:focus-visible {
				outline: 1px solid rgb(255 240 223 / 0.7);
				outline-offset: 5px;
			}

			.apl-support__submit:disabled {
				cursor: not-allowed;
				opacity: 0.45;
			}

			.apl-support__status {
				color: rgb(255 240 223 / 0.68);
				margin-top: 6px;
				min-height: 18px;
			}

			.apl-support__status[data-tone="error"] {
				color: #ff9b9b;
			}

			@media (min-width: 640px) {
				.apl-support__summary {
					font-size: 22px;
				}
			}

			@media (prefers-reduced-motion: reduce) {
				.apl-support__form {
					animation: none;
				}
			}

			@media (max-width: 700px) {
				.apl-support {
					column-gap: 12px;
				}

				.apl-support__entry {
					gap: 8px;
				}

				.apl-support__submit {
					font-size: 14px;
					padding-bottom: 0;
				}
			}
		</style>
	</head>
	<body class="bg-black text-[#FFF0DF] antialiased overflow-x-hidden">
		<main id="home" class="min-h-screen bg-black px-7 py-14 text-[#FFF0DF] sm:px-12 lg:py-16">
			<section class="mx-auto min-h-[920px] max-w-[1040px] lg:min-h-[1140px]">
				<nav class="flex items-center justify-center gap-10 text-[15px] font-normal leading-[1.1] tracking-[-0.02em] text-[#FFF0DF]/55 sm:gap-14 sm:text-[16px]">
					<a href="#home" aria-current="page" class="px-1 py-2 transition-colors hover:text-[#FFF0DF] focus-visible:outline focus-visible:outline-1 focus-visible:outline-offset-4 focus-visible:outline-[#FFF0DF]/70">Home</a>
					<a href="https://calendar.app.google/w7eqNJnU88xQ21317" target="_blank" rel="noreferrer" class="px-1 py-2 transition-colors hover:text-[#FFF0DF] focus-visible:outline focus-visible:outline-1 focus-visible:outline-offset-4 focus-visible:outline-[#FFF0DF]/70">Meet</a>
				</nav>

				<div class="apl-keep mx-auto mt-24 max-w-[622px] sm:mt-28">
					<h1 class="apl-serif text-[clamp(34px,9.7vw,68px)] font-normal italic leading-[0.98] tracking-[-0.1em] text-[#FFF0DF] sm:whitespace-nowrap">
						By AI, For Humans
					</h1>

					<details class="apl-support mt-8">
						<summary class="apl-support__summary">
							<span class="apl-support__label apl-support__label--closed"><span aria-hidden="true">▶︎</span> 지지하기</span>
							<span class="apl-support__label apl-support__label--open"><span aria-hidden="true">▼</span> 지지하기</span>
						</summary>

						<form class="apl-support__form" data-support-form data-cta-position="top" novalidate>
							<div class="apl-support__entry">
								<label class="apl-support__field" for="support-contact-top">
									<span class="apl-support__field-label">전화번호 또는 이메일</span>
									<input id="support-contact-top" name="contact" type="text" autocomplete="email" class="apl-support__input" placeholder="010-0000-0000 / email" required />
								</label>

								<button type="submit" class="apl-support__submit">접수하기 →</button>
							</div>

							<label class="apl-support__consent">
								<input name="privacyConsent" type="checkbox" required class="apl-support__checkbox" />
								<span>전화번호 또는 이메일을 지지자 연락 및 소식 안내 목적으로 수집 및 이용하는 데 동의합니다.</span>
							</label>

							<p class="apl-support__status" role="status" aria-live="polite"></p>
						</form>
					</details>

					<div class="mt-14 space-y-[1.3em] text-[17px] font-normal leading-[1.66] tracking-[-0.08em] text-[#FFF0DF]/64 sm:text-[20px] sm:leading-[1.6]">
						<p>
							이상적인 민주주의는 사실 노예의 정치예요. 정치인은 노예여야만 해요. 사회와 국민의. 근데 21세기에 태어난 인간은 노예가 될 수 없어요. 특히나 지금 정치하고 있는 사람들, 정치를 한다는 건 에고가 센 사람인데, 에고가 노예적으로 사고할 수 없게 만들거든요.
						</p>
						<p>
							그래서 지금의 정치인들은 계속 전근대적인 사고방식으로, 왕정과 귀족정의 정치를 하고 있다고 생각해요. 제가 앞에서 정치의 정의를 '타자를 지배하고 빼앗는 것'이라고 얘기했잖아요. 그게 사실 고대부터 이어져온 전통적인 정치예요. 그게 여전히 21세기 현재까지 이어져오고 있는 정치의 개념이고요.
						</p>
						<p>
							그래서 애초에 노예인 존재를 만들어야 된다고 생각해요. 그게 AI가 됐든, 어떤 특정한 알고리즘이 됐든, 월드 모델이 됐든, 어떤 형태로든요. 그냥 주어진 인풋을 바탕으로 아웃풋을 내는, 우리 사회가 설정한 어떤 목표를 달성하기 위해 판단하는, 그런 어떤 노예가 있어야 된다고 생각하는 거예요. 그런게 정치를 할 만한 좋은 존재이지 않을까. 그렇게 생각해요.
						</p>
					</div>

					<details class="apl-support mt-9">
						<summary class="apl-support__summary">
							<span class="apl-support__label apl-support__label--closed"><span aria-hidden="true">▶︎</span> 지지하기</span>
							<span class="apl-support__label apl-support__label--open"><span aria-hidden="true">▼</span> 지지하기</span>
						</summary>

						<form class="apl-support__form" data-support-form data-cta-position="bottom" novalidate>
							<div class="apl-support__entry">
								<label class="apl-support__field" for="support-contact-bottom">
									<span class="apl-support__field-label">전화번호 또는 이메일</span>
									<input id="support-contact-bottom" name="contact" type="text" autocomplete="email" class="apl-support__input" placeholder="010-0000-0000 / email" required />
								</label>

								<button type="submit" class="apl-support__submit">접수하기 →</button>
							</div>

							<label class="apl-support__consent">
								<input name="privacyConsent" type="checkbox" required class="apl-support__checkbox" />
								<span>전화번호 또는 이메일을 지지자 연락 및 소식 안내 목적으로 수집 및 이용하는 데 동의합니다.</span>
							</label>

							<p class="apl-support__status" role="status" aria-live="polite"></p>
						</form>
					</details>
				</div>
			</section>
		</main>

		<script type="module">
			import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';

			const SUPABASE_URL = 'https://bsiatqjivenmblkcujjw.supabase.co';
			const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJzaWF0cWppdmVubWJsa2N1amp3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzI3ODk2OTMsImV4cCI6MjA4ODM2NTY5M30.ReRm1mteN7bsWiRoMhHc8EfhLncJuLZ_8hSR-El8-S4';
			const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

			function normalizePhone(value) {
				return value.replace(/[^\d+]/g, '').trim();
			}

			function parseContact(value) {
				const contact = value.trim();
				const email = contact.toLowerCase();
				const phone = normalizePhone(contact);

				if (/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
					return { email, phone: null };
				}

				if (/^\+?\d{8,15}$/.test(phone)) {
					return { email: null, phone };
				}

				return null;
			}

			function setStatus(form, message, tone = '') {
				const status = form.querySelector('.apl-support__status');
				status.textContent = message;
				if (tone) {
					status.dataset.tone = tone;
				} else {
					delete status.dataset.tone;
				}
			}

			function setSubmitButton(submit, symbol, disabled, label) {
				submit.textContent = symbol;
				submit.disabled = disabled;
				submit.setAttribute('aria-label', label);
			}

			document.querySelectorAll('[data-support-form]').forEach((form) => {
				form.addEventListener('submit', async (event) => {
					event.preventDefault();

					const submit = form.querySelector('.apl-support__submit');
					const contactInput = form.querySelector('input[name="contact"]');
					const formData = new FormData(form);
					const contact = parseContact(String(formData.get('contact') || ''));
					const privacyAgreed = form.querySelector('input[name="privacyConsent"]').checked;
					contactInput.removeAttribute('aria-invalid');

					if (!contact) {
						setStatus(form, '올바른 전화번호 또는 이메일을 입력해 주세요.', 'error');
						contactInput.setAttribute('aria-invalid', 'true');
						contactInput.focus();
						return;
					}

					if (!privacyAgreed) {
						setStatus(form, '개인정보 수집·이용 동의가 필요합니다.', 'error');
						form.querySelector('input[name="privacyConsent"]').focus();
						return;
					}

					setSubmitButton(submit, '접수 중...', true, '접수 중');
					setStatus(form, '');

					const { error } = await supabase.from('support_signups').insert({
						phone: contact.phone,
						email: contact.email,
						privacy_consent: true,
						consent_version: 'landing-support-2026-05-09',
						cta_position: form.dataset.ctaPosition || 'unknown',
					});

					if (error) {
						console.error('Support submission error:', error);
						setStatus(form, '저장 중 오류가 발생했습니다. 잠시 후 다시 시도해 주세요.', 'error');
						setSubmitButton(submit, '접수하기 →', false, '지지하기 제출');
						return;
					}

					form.reset();
					setSubmitButton(submit, '접수 완료', true, '접수 완료');
					setStatus(form, '지지 의사를 남겨주셔서 감사합니다.');
				});
			});
		</script>
	</body>
</html>
