			}
			@media (prefers-reduced-motion: reduce) { .home-content *, .home-toc * { scroll-behavior: auto; transition: none; } }
		</style>

		<script>
			const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc-link'));
			const tocIds = tocLinks.map(link => link.hash.slice(1));
			function setActiveToc(id) {
				tocLinks.forEach(l => l.classList.toggle('active', l.getAttribute('href') === '#' + id));
			}
			function onTocScroll() {
				let current = tocIds[0];
				for (const id of tocIds) {
					const el = document.getElementById(id);
					if (el && el.getBoundingClientRect().top <= 100) current = id;
				}
				setActiveToc(current);
			}
			window.addEventListener('scroll', onTocScroll, { passive: true });
			window.addEventListener('resize', onTocScroll);
			onTocScroll();

			const profileTrack = document.querySelector<HTMLElement>('#organizer-profiles');
			const profilePrev = document.querySelector<HTMLButtonElement>('#organizer-prev');
			const profileNext = document.querySelector<HTMLButtonElement>('#organizer-next');
			if (profileTrack && profilePrev && profileNext) {
				const updateProfileControls = () => {
					const lastPosition = profileTrack.scrollWidth - profileTrack.clientWidth;
					profilePrev.disabled = profileTrack.scrollLeft <= 1;
					profileNext.disabled = profileTrack.scrollLeft >= lastPosition - 1;
				};
				const scrollProfiles = (direction: number) => {
					const card = profileTrack.querySelector('li');
					if (!card) return;
					const gap = parseFloat(getComputedStyle(profileTrack).columnGap) || 0;
					profileTrack.scrollBy({
						left: direction * (card.getBoundingClientRect().width + gap),
						behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
					});
				};
				profilePrev.addEventListener('click', () => scrollProfiles(-1));
				profileNext.addEventListener('click', () => scrollProfiles(1));
				profileTrack.addEventListener('keydown', (event) => {
					if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
						event.preventDefault();
						scrollProfiles(event.key === 'ArrowLeft' ? -1 : 1);
					}
				});
				profileTrack.addEventListener('scroll', updateProfileControls, { passive: true });
				window.addEventListener('resize', updateProfileControls);
				updateProfileControls();
			}

			const tocToggle = document.getElementById('toc-toggle');
			const tocOverlay = document.getElementById('toc-overlay');
			if (tocToggle && tocOverlay) {
				const setTocOpen = (open) => {
					tocOverlay.classList.toggle('hidden', !open);
					tocToggle.setAttribute('aria-expanded', String(open));
					tocToggle.setAttribute('aria-label', open ? '목차 닫기' : '목차 열기');
				};
				tocToggle.addEventListener('click', () => setTocOpen(tocOverlay.classList.contains('hidden')));
				tocOverlay.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setTocOpen(false)));
				document.addEventListener('keydown', (e) => {
					if (e.key === 'Escape' && !tocOverlay.classList.contains('hidden')) {
						setTocOpen(false);
						tocToggle.focus();
					}
				});
			}
		</script>

		<script type="module">
			import { supabase } from '/community/client.js';
			import { getReferral, signupReferralData } from '/community/referral.js';
			import { createFoundingSignup, foundingSignupError, validFoundingUsername } from '/community/founding-signup.js';
			import SignaturePad from 'https://esm.sh/signature_pad@5';
			const submitFoundingSignup = createFoundingSignup(supabase, { origin: location.origin, referralData: signupReferralData });
			let signedInUser = null;
			const scrollBehavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';

			// Keep the vector strokes independent of the responsive canvas bitmap.
			const canvas = document.getElementById('signature-canvas');
			const signaturePad = new SignaturePad(canvas, {
				backgroundColor: 'rgb(255, 255, 255)',
				penColor: 'rgb(0, 0, 0)',
			});
			let signatureStrokes = [];
			let signatureSize = { width: 0, height: 0 };
			signaturePad.addEventListener('endStroke', () => {
				signatureStrokes = signaturePad.toData().map(group => ({
					...group, points: group.points.map(point => ({ ...point })),
				}));
				const { width, height } = canvas.getBoundingClientRect();
				signatureSize = { width, height };
			});
			function resizeSignatureCanvas() {
				const { width, height } = canvas.getBoundingClientRect();
				if (!width || !height) return;
				const ratio = Math.max(window.devicePixelRatio || 1, 1);
				const bitmapWidth = Math.round(width * ratio);
				const bitmapHeight = Math.round(height * ratio);
				if (canvas.width === bitmapWidth && canvas.height === bitmapHeight) return;
				canvas.width = bitmapWidth;
				canvas.height = bitmapHeight;
				canvas.getContext('2d').setTransform(ratio, 0, 0, ratio, 0, 0);
				signaturePad.clear();
				if (signatureStrokes.length) {
					const scale = Math.min(width / signatureSize.width, height / signatureSize.height);
					signaturePad.fromData(signatureStrokes.map(group => ({
						...group, points: group.points.map(point => ({ ...point, x: point.x * scale, y: point.y * scale })),
					})));
				}
			}
			function clearSignature() {
				signatureStrokes = [];
				signatureSize = { width: 0, height: 0 };
				signaturePad.clear();
			}
			new ResizeObserver(resizeSignatureCanvas).observe(canvas);
			window.addEventListener('resize', resizeSignatureCanvas);
			resizeSignatureCanvas();
			document.getElementById('clear-signature').addEventListener('click', clearSignature);

			// 자택 전화번호 크롬 자동완성 방지
			const phoneHome = document.getElementById('phone_home');
			const clearAutofill = () => {
				if (phoneHome.value && !phoneHome.dataset.userTyped) {
					phoneHome.value = '';
				}
			};
			document.querySelectorAll('input').forEach(input => {
				input.addEventListener('focus', () => setTimeout(clearAutofill, 20));
			});
			phoneHome.addEventListener('animationstart', clearAutofill);
			phoneHome.addEventListener('keydown', () => { phoneHome.dataset.userTyped = '1'; });

			// 다음 주소 검색 API (클릭 시점에 스크립트 지연 로드)
			const postcodeLayer = document.getElementById('postcode-layer');
			let daumLoader = null;
			function loadDaumPostcode() {
				if (window.daum && window.daum.Postcode) return Promise.resolve();
				if (daumLoader) return daumLoader;
				daumLoader = new Promise((resolve, reject) => {
					const s = document.createElement('script');
					s.src = 'https://t1.daumcdn.net/mapjsapi/bundle/postcode/prod/postcode.v2.js';
					s.onload = () => resolve();
					s.onerror = () => { daumLoader = null; reject(new Error('주소 검색 모듈을 불러오지 못했습니다.')); };
					document.head.appendChild(s);
				});
				return daumLoader;
			}

			const searchAddressBtn = document.getElementById('search-address');
			searchAddressBtn.addEventListener('click', async () => {
				searchAddressBtn.disabled = true;
				try {
					await loadDaumPostcode();
				} catch (err) {
					searchAddressBtn.disabled = false;
					const ae = document.getElementById('address-error');
					ae.textContent = '주소 검색을 불러오지 못했습니다. 잠시 후 다시 시도해 주세요.';
					ae.classList.remove('hidden');
					return;
				}
				searchAddressBtn.disabled = false;
				postcodeLayer.classList.remove('hidden');
				new daum.Postcode({
					oncomplete(data) {
						document.getElementById('postcode').value = data.zonecode;
						document.getElementById('address').value = data.roadAddress || data.jibunAddress;
						postcodeLayer.classList.add('hidden');
						document.getElementById('address_detail').focus();
					},
					width: '100%',
					height: '100%',
				}).embed(postcodeLayer);
				postcodeLayer.scrollIntoView({ behavior: scrollBehavior, block: 'center' });
			});

			document.getElementById('close-postcode').addEventListener('click', () => {
				postcodeLayer.classList.add('hidden');
			});

			// 생년월일 자동 하이픈 입력
			document.getElementById('birth_date').addEventListener('input', (e) => {
				let v = e.target.value.replace(/[^0-9]/g, '');
				if (v.length > 8) v = v.slice(0, 8);
				if (v.length >= 6) {
					v = v.slice(0, 4) + '-' + v.slice(4, 6) + '-' + v.slice(6);
				} else if (v.length >= 4) {
					v = v.slice(0, 4) + '-' + v.slice(4);
				}
				e.target.value = v;
			});

			// 휴대폰 번호 자동 포맷
			function formatMobile(raw) {
				let v = raw.replace(/[^0-9+]/g, '');
				if (v.startsWith('+82')) v = '0' + v.slice(3);
				else if (v.startsWith('82')) v = '0' + v.slice(2);
				v = v.replace(/[^0-9]/g, '');
				if (v.length > 11) v = v.slice(0, 11);
				if (v.length >= 8) {
					return v.slice(0, 3) + '-' + v.slice(3, v.length - 4) + '-' + v.slice(v.length - 4);
				} else if (v.length >= 4) {
					return v.slice(0, 3) + '-' + v.slice(3);
				}
				return v;
			}

			document.getElementById('phone_mobile').addEventListener('input', (e) => {
				e.target.value = formatMobile(e.target.value);
			});

			// Set today's date
			const today = new Date();
			const yyyy = today.getFullYear();
			const mm = String(today.getMonth() + 1).padStart(2, '0');
			const dd = String(today.getDate()).padStart(2, '0');
			document.getElementById('agreed-date').textContent = `${yyyy}년 ${mm}월 ${dd}일`;

			// Validation
			function validateForm(form) {
				const errors = [];
				const fd = new FormData(form);
				if (!signedInUser) {
					const username = fd.get('username')?.trim().toLowerCase() || '';
					if (!validFoundingUsername(username)) errors.push({ field: 'signup-username', message: '아이디는 영문 소문자로 시작하는 3~24자의 영문·숫자·밑줄로 입력해 주세요.' });
					if (!document.getElementById('signup-email').validity.valid || !fd.get('email')?.trim()) errors.push({ field: 'signup-email', message: '인증 메일을 받을 수 있는 이메일을 입력해 주세요.' });
					const password = fd.get('password') || '';
					if (password.length < 10 || password.length > 128) errors.push({ field: 'signup-password', message: '비밀번호는 10~128자로 입력해 주세요.' });
					const referrer = fd.get('referrer')?.trim().toLowerCase() || '';
					if (referrer && (!/^[a-z][a-z0-9_]{2,23}$/.test(referrer) || referrer === username)) errors.push({ field: 'referrer', message: '추천인의 사이트 아이디를 입력해 주세요. 내 아이디는 입력할 수 없습니다.' });
				}

				const name = fd.get('name')?.trim();
				if (!name || name.length < 2) {
					errors.push({ field: 'name', message: '이름을 2자 이상 입력해 주세요.' });
				}

				const birthRaw = fd.get('birth_date')?.trim();
				if (!birthRaw || !/^\d{4}-\d{2}-\d{2}$/.test(birthRaw)) {
					errors.push({ field: 'birth_date', message: '생년월일을 YYYY-MM-DD 형식으로 입력해 주세요.' });
				} else {
					const [by, bm, bd] = birthRaw.split('-').map(Number);
					const birth = new Date(by, bm - 1, bd);
					const now = new Date();
					const validDate = birth.getFullYear() === by && birth.getMonth() === bm - 1 && birth.getDate() === bd;
					if (!validDate || birth > now) {
						errors.push({ field: 'birth_date', message: '올바른 날짜를 입력해 주세요.' });
					} else {
						const ageDiff = now.getFullYear() - birth.getFullYear();
						const monthDiff = now.getMonth() - birth.getMonth();
						const age = monthDiff < 0 || (monthDiff === 0 && now.getDate() < birth.getDate()) ? ageDiff - 1 : ageDiff;
						if (age < 18) {
							errors.push({ field: 'birth_date', message: '만 18세 이상만 참여할 수 있습니다.' });
						}
					}
				}

				const gender = fd.get('gender');
				if (!gender) {
					errors.push({ field: 'gender', message: '성별을 선택해 주세요.', isGroup: true });
				}

				const occupation = fd.get('occupation')?.trim();
				if (!occupation) {
					errors.push({ field: 'occupation', message: '직업을 입력해 주세요.' });
				}

				const address = fd.get('address')?.trim();
				if (!address || address.length < 5) {
					errors.push({ field: 'address', message: '주소 검색 버튼을 눌러 주소를 입력해 주세요.', isAddress: true });
				}
				if (!fd.get('address_detail')?.trim()) {
					errors.push({ field: 'address_detail', message: '상세주소를 입력해 주세요.' });
				}

				const phoneMobile = fd.get('phone_mobile')?.trim();
				const cleanPhone = phoneMobile?.replace(/[-\s]/g, '');
				if (!cleanPhone || !/^01[016789]\d{7,8}$/.test(cleanPhone)) {
					errors.push({ field: 'phone_mobile', message: '올바른 휴대폰 번호를 입력해 주세요.' });
				}

				if (signaturePad.isEmpty()) {
					errors.push({ field: 'signature', message: '서명을 해 주세요.', isSignature: true });
				}

				const privacyAgreed = form.querySelector('#privacy_agreed').checked;
				if (!privacyAgreed) {
					errors.push({ field: 'privacy_agreed', message: '동의에 체크해 주세요.' });
				}

				return errors;
			}

			function showFieldErrors(errors) {
				errors.forEach(({ field, message, isGroup, isSignature, isAddress }) => {
					if (isSignature) {
						const el = document.getElementById('signature-error');
						el.textContent = message;
						el.classList.remove('hidden');
						return;
					}
					if (isGroup) {
						const el = document.getElementById('gender-error');
						el.textContent = message;
						el.classList.remove('hidden');
						return;
					}
					if (isAddress) {
						const el = document.getElementById('address-error');
						el.textContent = message;
						el.classList.remove('hidden');
						return;
					}
					const input = document.getElementById(field);
					if (input) {
						const errorEl = input.closest('div').querySelector('.field-error');
						if (errorEl) {
							errorEl.textContent = message;
							errorEl.classList.remove('hidden');
						}
						input.classList.add('border-red-400');
						input.addEventListener('input', () => {
							input.classList.remove('border-red-400');
							if (errorEl) errorEl.classList.add('hidden');
						}, { once: true });
					}
				});

				const firstField = errors[0];
				if (firstField.isSignature) {
					document.getElementById('signature-canvas').scrollIntoView({ behavior: scrollBehavior, block: 'center' });
				} else if (firstField.isGroup) {
					document.getElementById('gender-group').scrollIntoView({ behavior: scrollBehavior, block: 'center' });
				} else if (firstField.isAddress) {
					document.getElementById('address').scrollIntoView({ behavior: scrollBehavior, block: 'center' });
				} else {
					const el = document.getElementById(firstField.field);
					if (el) {
						el.scrollIntoView({ behavior: scrollBehavior, block: 'center' });
						el.focus();
					}
				}
			}

			// Form submission
			const form = document.getElementById('founding-member-form');
			const submitBtn = document.getElementById('submit-btn');
			const successDiv = document.getElementById('success-message');
			const errorDiv = document.getElementById('error-message');
			const accountFields = document.getElementById('founder-account-fields');
			const signedInNotice = document.getElementById('founder-signed-in');
			const automaticReferral = document.getElementById('founder-automatic-referral');
			const getSubmitLabel = () => signedInUser ? '발기인 동의서 제출하기' : '발기인 동의하고 가입하기';

			async function refreshAccountState() {
				const { data, error } = await supabase.auth.getUser();
				if (error && !/AuthSessionMissingError|session.*missing|session_not_found/i.test(`${error.name || ''} ${error.code || ''} ${error.message || ''}`)) throw error;
				signedInUser = data?.user || null;
				accountFields.hidden = Boolean(signedInUser);
				accountFields.disabled = Boolean(signedInUser);
				signedInNotice.hidden = !signedInUser;
				signedInNotice.textContent = signedInUser?.email_confirmed_at
					? '로그인한 계정으로 발기인 동의서를 제출합니다. 별도의 가입은 필요하지 않습니다.'
					: '가입한 이메일의 인증 링크를 먼저 열어 주세요. 로그인 화면에서 인증 메일을 다시 받을 수 있습니다.';
				document.getElementById('founder-referrer-field').hidden = Boolean(signedInUser);
				document.getElementById('referrer').disabled = Boolean(signedInUser);
				submitBtn.textContent = getSubmitLabel();
				const referral = getReferral();
				automaticReferral.hidden = !referral;
				if (referral) automaticReferral.textContent = `@${referral.referrer} 님의 초대 링크로 방문했습니다. 다른 추천인 아이디를 입력하지 않으면 이 초대가 적용됩니다.`;
			}

			submitBtn.disabled = true;
			form.addEventListener('submit', async (e) => {
				e.preventDefault();
				if (form.getAttribute('aria-busy') === 'true') return;
				form.setAttribute('aria-busy', 'true');
				submitBtn.disabled = true;

				errorDiv.classList.add('hidden');
				document.querySelectorAll('.field-error').forEach(el => {
					el.textContent = '';
					el.classList.add('hidden');
				});
				document.querySelectorAll('.border-red-400').forEach(el => {
					el.classList.remove('border-red-400');
				});

				try {
					await refreshAccountState();
					const errors = validateForm(form);
					if (errors.length > 0) {
						showFieldErrors(errors);
						return;
					}
					submitBtn.textContent = '동의서와 계정을 접수하고 있습니다…';
					const fd = new FormData(form);
					const signatureData = signaturePad.toDataURL('image/png');

					const fullAddress = [fd.get('address').trim(), fd.get('address_detail')?.trim()].filter(Boolean).join(' ');

					const now = new Date();
					const agreedAt = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;

					const founder = {
						name: fd.get('name').trim(),
						address: fullAddress,
						birth_date: fd.get('birth_date'),
						gender: fd.get('gender'),
						occupation: fd.get('occupation').trim(),
						phone_home: fd.get('phone_home')?.trim() || null,
						phone_mobile: fd.get('phone_mobile').trim(),
						signature_data: signatureData,
						agreed_at: agreedAt,
						privacy_agreed: true,
						public_consent: form.querySelector('#public_consent').checked,
					};
					const result = await submitFoundingSignup({
						email: fd.get('email') || '',
						username: fd.get('username') || '',
						displayName: '',
						password: fd.get('password') || '',
						referrerUsername: fd.get('referrer') || '',
						founder,
					});
					document.getElementById('signup-password').value = '';
					clearSignature();
					form.reset();
					const needsVerification = result.kind === 'created' && result.verificationRequired;
					document.getElementById('founder-success-title').textContent = result.kind === 'created'
						? '발기인 동의와 가입이 완료되었습니다'
						: result.alreadyRegistered ? '이미 발기인 동의서가 접수되어 있습니다' : '발기인 동의서가 접수되었습니다';
					document.getElementById('founder-success-detail').textContent = needsVerification
						? '동의서와 계정은 함께 저장되었습니다. 가입한 이메일의 인증 링크를 열면 나의 초대 현황을 이용할 수 있습니다. 메일이 없으면 스팸함을 확인하거나 인증 메일을 다시 받아 주세요.'
						: '함께해 주셔서 감사합니다. 이제 나의 링크로 사람들을 초대해 보세요.';
					const successLink = document.getElementById('founder-success-link');
					successLink.href = needsVerification ? '/auth' : '/account';
					successLink.textContent = needsVerification ? '로그인하기' : '나의 초대 현황 보기';

					form.classList.add('hidden');
					successDiv.classList.remove('hidden');
					successDiv.scrollIntoView({ behavior: scrollBehavior, block: 'center' });

				} catch (err) {
					errorDiv.textContent = foundingSignupError(err);
					errorDiv.classList.remove('hidden');
				} finally {
					form.setAttribute('aria-busy', 'false');
					submitBtn.disabled = false;
					submitBtn.textContent = getSubmitLabel();
				}
			});

			// Unlock only after dependencies and the submit guard have initialized.
			refreshAccountState().catch(() => {
				errorDiv.textContent = '로그인 상태를 확인하지 못했습니다. 입력 후 다시 제출하면 재확인합니다.';
				errorDiv.classList.remove('hidden');
			}).finally(() => {
				form.removeAttribute('inert');
				form.setAttribute('aria-busy', 'false');
				document.getElementById('founder-form-loading').hidden = true;
				submitBtn.disabled = false;
			});
		</script>
		<script type="module" src="/community/nav.js" is:inline></script>
</Layout>
