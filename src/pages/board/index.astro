---
import CommunityLayout from '../../layouts/CommunityLayout.astro';
---

<CommunityLayout title="자유게시판 — AI정치연구소" description="AI정치연구소 회원들과 생각과 소식을 나누는 자유게시판입니다." active="board">
  <section class="c-page" aria-labelledby="board-heading">
    <div class="board-heading">
      <div>
        <h1 id="board-heading" class="c-heading">자유게시판</h1>
        <p class="c-muted board-intro">함께 나누고 싶은 생각과 소식을 남겨 주세요.</p>
      </div>
      <a class="c-button c-button-secondary" href="/board/write"><span aria-hidden="true">＋</span> 글쓰기</a>
    </div>

    <form id="board-search" class="board-search" action="/board" method="get" role="search">
      <label class="c-field board-search-field" for="board-query">
        <span class="board-search-label">게시글 검색</span>
        <input id="board-query" class="c-input" type="search" name="q" maxlength="120" placeholder="제목 또는 내용으로 검색" autocomplete="off" />
      </label>
      <button class="c-button c-button-secondary" type="submit">검색</button>
      <a id="board-clear" class="c-link" href="/board" hidden>전체 글 보기</a>
    </form>

    <div class="board-summary">
      <p id="board-count" class="c-muted" aria-live="polite">게시글을 불러오는 중입니다.</p>
      <p class="c-muted">누구나 읽고, 이메일 인증 후 쓸 수 있어요.</p>
    </div>
    <p id="board-message" class="c-message" role="status" aria-live="polite" hidden></p>
    <section aria-label="게시글 목록" aria-busy="true" id="board-results">
      <div id="board-list" class="c-list board-list"></div>
      <div id="board-empty" class="c-empty" hidden>
        <svg class="board-empty-icon" viewBox="0 0 72 72" fill="none" aria-hidden="true"><rect x="15" y="9" width="42" height="54" rx="9" fill="currentColor" fill-opacity=".05" stroke="currentColor" stroke-opacity=".25" stroke-width="2" /><path d="M26 25h20M26 35h14M26 45h18" stroke="currentColor" stroke-opacity=".4" stroke-width="3" stroke-linecap="round" /></svg>
        <h2 id="board-empty-title">아직 게시글이 없습니다.</h2>
        <p id="board-empty-description" class="c-muted">첫 번째 이야기를 남겨 보세요.</p>
        <a id="board-empty-write" class="c-button c-button-secondary" href="/board/write"><span aria-hidden="true">＋</span> 첫 글 쓰기</a>
      </div>
    </section>
    <nav id="board-pagination" class="c-actions board-pagination" aria-label="게시글 페이지" hidden>
      <a id="board-prev" class="c-button c-button-secondary" href="/board" rel="prev">이전</a>
      <span id="board-page" class="c-muted" aria-live="polite"></span>
      <a id="board-next" class="c-button c-button-secondary" href="/board" rel="next">다음</a>
    </nav>
    <noscript><p class="c-message">게시글을 보려면 브라우저에서 자바스크립트를 켜 주세요.</p></noscript>
  </section>
  <script type="module" src="/community/board.js" is:inline></script>
</CommunityLayout>

<style>
  .board-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; }
  .board-heading .c-heading { margin: 0; font-size: 32px; font-weight: 650; letter-spacing: -.8px; line-height: 1.25; }
  .board-intro { margin: 10px 0 0; }
  .board-heading > .c-button { flex-shrink: 0; }
  .board-search { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; margin: 28px 0 22px; }
  .board-search-field { flex: 1 1 240px; max-width: 420px; }
  .board-search-label { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .board-search .c-input { background: rgba(255,255,255,.54); border-color: rgba(99,110,130,.12); }
  .board-search > .c-link { margin-left: 4px; }
  .board-summary { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px 24px; margin-bottom: 24px; font-size: 13px; }
  .board-summary p { margin: 0; }
  .board-summary .c-muted { font-size: 13px; }
  .board-list { position: relative; border: 0; }
  .board-list::before { content: ''; position: absolute; left: 112px; top: 15px; bottom: 28px; width: 1px; background: rgba(126,140,156,.15); }
  .board-list:empty::before { display: none; }
  .board-list :global(.c-list-item) { position: relative; display: grid; grid-template-columns: 100px minmax(0,1fr); column-gap: 32px; padding: 0 0 16px; border: 0; }
  .board-list :global(.c-list-item::before) { content: ''; position: absolute; left: 108px; top: 12px; width: 9px; height: 9px; border: 2px solid rgba(139,152,168,.3); border-radius: 50%; background: var(--c-bg, #f4f7f9); }
  .board-list :global(.board-date) { display: flex; flex-direction: column; align-items: flex-start; gap: 3px; padding-top: 8px; font-size: 14px; line-height: 1.5; }
  .board-list :global(.board-date-label) { font-weight: 550; }
  .board-list :global(.board-date-day) { color: var(--c-muted); font-size: 13px; }
  .board-list :global(.board-post-link) { display: block; min-width: 0; color: inherit; text-decoration: none; padding: 18px 20px; border: 1px solid rgba(255,255,255,.8); border-radius: 14px; background: rgba(255,255,255,.76); box-shadow: 0 1px 3px rgba(31,41,55,.025); transition: background .15s, box-shadow .15s; }
  .board-list :global(.board-post-link:hover) { background: rgba(255,255,255,.95); box-shadow: 0 3px 12px rgba(31,41,55,.045); }
  .board-list :global(.board-time) { display: block; margin-bottom: 7px; color: var(--c-muted); font-size: 12px; line-height: 1.5; }
  .board-list :global(h2) { margin: 0 0 9px; font-size: 20px; line-height: 1.4; letter-spacing: -.35px; font-weight: 600; overflow-wrap: anywhere; }
  .board-list :global(.board-excerpt) { margin: 0 0 14px; font-size: 14px; line-height: 1.65; overflow-wrap: anywhere; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .board-list :global(.c-meta) { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; font-size: 12px; }
  .board-list :global(.board-author-mark) { display: inline-flex; align-items: center; justify-content: center; width: 18px; height: 18px; border-radius: 50%; color: #88919e; background: #e9edf2; font-size: 10px; font-weight: 600; }
  #board-empty { padding: 80px 20px 88px; }
  .board-empty-icon { width: 76px; height: 76px; margin: 0 auto 22px; color: var(--c-muted); }
  #board-empty h2 { color: var(--c-text); font-size: 18px; font-weight: 550; line-height: 1.5; }
  #board-empty p { margin: 9px 0 24px; }
  .board-pagination { justify-content: center; margin: 24px 0 0 132px; }
  :global(.dark) .board-search .c-input { background: rgba(255,255,255,.04); border-color: rgba(173,185,204,.16); }
  :global(.dark) .board-list :global(.board-post-link) { background: rgba(31,36,47,.8); border-color: rgba(173,185,204,.12); }
  :global(.dark) .board-list :global(.board-post-link:hover) { background: rgba(40,46,59,.95); }
  :global(.dark) .board-list :global(.board-author-mark) { background: #363e4c; color: #c1c8d3; }
  @media (max-width: 600px) {
    .board-heading { gap: 14px; }
    .board-heading .c-heading { font-size: 27px; }
    .board-heading > .c-button { padding-inline: 12px; }
    .board-intro { max-width: 220px; font-size: 13px; }
    .board-search { margin-top: 24px; }
    .board-search-field { max-width: none; flex: 1 1 150px; }
    .board-summary { flex-direction: column; }
    .board-list::before { left: 73px; }
    .board-list :global(.c-list-item) { grid-template-columns: 62px minmax(0,1fr); column-gap: 24px; padding-bottom: 14px; }
    .board-list :global(.c-list-item::before) { left: 69px; }
    .board-list :global(.board-date) { font-size: 12px; }
    .board-list :global(.board-date-day) { font-size: 11px; }
    .board-list :global(.board-post-link) { padding: 14px; }
    .board-list :global(h2) { font-size: 17px; }
    .board-list :global(.board-excerpt) { font-size: 13px; }
    .board-pagination { margin-left: 86px; gap: 8px; }
    .board-pagination .c-button { padding-inline: 12px; }
  }
</style>
