---
interface Props {
	title: string;
	bodyClass?: string;
}
const { title, bodyClass = "bg-white text-stone-900 dark:bg-[#0e0e0d] dark:text-stone-100 antialiased overflow-x-hidden" } = Astro.props;
import "../styles/global.css";
---

<!doctype html>
<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0e0e0d" media="(prefers-color-scheme: dark)" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="stylesheet" href="/community/community.css" />
		<script is:inline>
			// FOUC 방지: 페인트 전에 테마 결정 (localStorage 우선, 없으면 시스템 설정)
			(function () {
				try {
					var s = localStorage.getItem("theme");
					var dark = s ? s === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
					document.documentElement.classList.toggle("dark", dark);
				} catch (e) {}
			})();
		</script>
		<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
		<link
			rel="stylesheet"
			as="style"
			crossorigin
			href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
		/>
		<title>{title}</title>
		<slot name="head" />
	</head>
	<body class={`luma-shell ${bodyClass}`}>
		<slot />
		<script type="module" src="/community/capture.js" is:inline></script>

		<!-- 다크/라이트 토글 (전역, 모든 페이지 공통) -->
		<button
			id="theme-toggle"
			type="button"
			aria-label="다크/라이트 모드 전환"
			class="fixed bottom-5 right-5 z-[100] h-11 w-11 flex items-center justify-center rounded-full border border-stone-300 bg-white/85 text-stone-800 shadow-sm backdrop-blur-md transition-colors hover:bg-stone-100 dark:border-white/20 dark:bg-[#0e0e0d]/85 dark:text-stone-100 dark:hover:bg-white/10"
		>
			<!-- 라이트 모드일 때 표시: 달(→다크로) -->
			<svg class="w-5 h-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
			</svg>
			<!-- 다크 모드일 때 표시: 해(→라이트로) -->
			<svg class="w-5 h-5 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<circle cx="12" cy="12" r="4" />
				<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
			</svg>
		</button>
		<script is:inline>
			(function () {
				var btn = document.getElementById("theme-toggle");
				if (!btn) return;
				btn.addEventListener("click", function () {
					var isDark = document.documentElement.classList.contains("dark");
					try { localStorage.setItem("theme", isDark ? "light" : "dark"); } catch (e) {}
					document.documentElement.classList.toggle("dark", !isDark);
				});
			})();
		</script>
	</body>
</html>
