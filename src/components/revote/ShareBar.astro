---
// 공유 버튼 묶음 (카카오 공유 + 링크 복사). 카카오 키 미설정 시 링크복사로 폴백.
interface Props {
  class?: string;
  compact?: boolean;
}
const { class: cls = "", compact = false } = Astro.props;
---

<div class={`revote-sharebar flex flex-wrap gap-2.5 ${cls}`}>
  <button
    type="button"
    data-share="kakao"
    class="inline-flex items-center gap-2 h-10 px-4 text-sm font-medium text-stone-900 bg-[#FEE500] rounded-full hover:brightness-95 transition tracking-[-0.14px]"
  >
    카카오톡으로 공유하기
  </button>
  <button
    type="button"
    data-share="instagram"
    class="inline-flex items-center gap-2 h-10 px-4 text-sm font-medium text-white bg-gradient-to-tr from-[#feda75] via-[#d62976] to-[#4f5bd5] rounded-full hover:brightness-95 transition tracking-[-0.14px]"
  >
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
    인스타 스토리 공유
  </button>
  <button
    type="button"
    data-share="copy"
    class="inline-flex items-center gap-2 h-10 px-4 text-sm font-medium text-stone-700 border border-stone-300 rounded-full hover:bg-stone-100 transition tracking-[-0.14px]"
  >
    <span class="js-copy-label">링크 복사하기</span>
  </button>
  {
    !compact && (
      <a
        href="https://twitter.com/intent/tweet"
        data-share="x"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 h-10 px-4 text-sm font-medium text-stone-700 border border-stone-300 rounded-full hover:bg-stone-100 transition tracking-[-0.14px]"
      >
        X(트위터) 공유
      </a>
    )
  }
</div>

<script>
  import {
    copyShareLink,
    getStoredRef,
    track,
    SITE_URL,
  } from "/revote/revote-client.js";

  const SHARE_DESC =
    "투표용지가 부족했고, 일부 시민은 투표를 포기했습니다. 선거권 회복을 위한 100만 서명에 함께해주세요.";

  // referral code: 완료 화면에서 window.__revoteRef 로 주입되거나, 저장된 유입 ref 사용
  function currentRef() {
    return (window as any).__revoteRef || getStoredRef() || "";
  }
  function shareUrl() {
    const ref = currentRef();
    return SITE_URL + (ref ? `/?ref=${ref}&ch=` : "/?ch=");
  }

  // 카카오 SDK 동적 로드 (public/revote/kakao.js 에서 init 처리)
  async function kakaoShare() {
    const ref = currentRef();
    try {
      const mod = await import("/revote/kakao.js");
      if (mod && mod.shareKakao) {
        const ok = await mod.shareKakao({
          url: SITE_URL + (ref ? `/?ref=${ref}&ch=kakao` : "/?ch=kakao"),
          title: "선거권 회복 100만 서명운동",
          description: SHARE_DESC,
        });
        if (ok) {
          track("share_kakao_click", { ref });
          return;
        }
      }
    } catch (_) {}
    // 폴백: 링크 복사
    await doCopy("kakao");
  }

  // 인스타그램 스토리 공유
  // 모바일: Web Share(이미지 파일 포함) → 공유시트에서 "스토리" 선택 가능
  // 데스크톱: 링크 복사 + 안내
  async function shareInstagram() {
    const ref = currentRef();
    const url = SITE_URL + (ref ? `/?ref=${ref}&ch=instagram` : "/?ch=instagram");
    const TITLE = "선거권 회복 100만 서명운동";

    let file: File | null = null;
    try {
      const resp = await fetch("https://aiparty.kr/og-main-v2.png");
      if (resp.ok) {
        const blob = await resp.blob();
        file = new File([blob], "revote.png", { type: blob.type || "image/png" });
      }
    } catch (_) {}

    if (file && navigator.canShare && navigator.canShare({ files: [file] })) {
      try {
        await navigator.share({ files: [file], title: TITLE, text: SHARE_DESC + "\n" + url });
        track("share_instagram_click", { ref, mode: "file" });
      } catch (_) {}
      return;
    }

    if (navigator.share) {
      try {
        await navigator.share({ title: TITLE, text: SHARE_DESC, url });
        track("share_instagram_click", { ref, mode: "url" });
      } catch (_) {}
      return;
    }

    const ok = await copyShareLink(ref);
    track("share_instagram_click", { ref, mode: "copy" });
    alert(
      ok
        ? "링크를 복사했어요. 인스타그램 앱에서 스토리에 붙여넣어 공유해주세요."
        : "인스타그램 앱에서 스토리로 공유해주세요."
    );
  }

  async function doCopy(channel: string) {
    const ok = await copyShareLink(currentRef());
    track("copy_link_click", { channel, ref: currentRef() });
    document.querySelectorAll(".js-copy-label").forEach((el) => {
      const prev = el.textContent;
      el.textContent = ok ? "복사됨!" : "복사 실패";
      setTimeout(() => (el.textContent = prev || "링크 복사하기"), 1500);
    });
  }

  document.querySelectorAll<HTMLElement>(".revote-sharebar [data-share]").forEach((btn) => {
    const kind = btn.dataset.share;
    if (kind === "x") {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        const u = shareUrl() + "x";
        const text = encodeURIComponent(SHARE_DESC + "\n" + u);
        window.open(`https://twitter.com/intent/tweet?text=${text}`, "_blank", "noopener");
        track("share_x_click", { ref: currentRef() });
      });
      return;
    }
    btn.addEventListener("click", () => {
      if (kind === "kakao") kakaoShare();
      else if (kind === "instagram") shareInstagram();
      else doCopy("link");
    });
  });
</script>
