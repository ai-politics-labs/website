---
// 우하단 플로팅 공유 버튼. 클릭 시 공유 옵션(카카오/인스타/X/링크복사)이 위로 펼쳐짐.
---

<div class="revote-fab fixed bottom-5 right-5 sm:bottom-6 sm:right-6 z-[60] flex flex-col items-end gap-3">
  <!-- 펼쳐지는 옵션들 -->
  <div
    data-fab-menu
    class="flex flex-col items-end gap-2 opacity-0 translate-y-2 pointer-events-none transition duration-200 ease-out"
  >
    <button
      type="button"
      data-share="kakao"
      class="inline-flex items-center gap-2 h-10 px-4 text-sm font-medium text-stone-900 bg-[#FEE500] rounded-full shadow-lg shadow-black/15 hover:brightness-95 transition tracking-[-0.14px]"
    >
      카카오톡 공유
    </button>
    <button
      type="button"
      data-share="instagram"
      class="inline-flex items-center gap-2 h-10 px-4 text-sm font-medium text-white bg-gradient-to-tr from-[#feda75] via-[#d62976] to-[#4f5bd5] rounded-full shadow-lg shadow-black/15 hover:brightness-95 transition tracking-[-0.14px]"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
      인스타 공유
    </button>
    <a
      href="https://twitter.com/intent/tweet"
      data-share="x"
      target="_blank"
      rel="noopener"
      class="inline-flex items-center gap-2 h-10 px-4 text-sm font-medium text-white bg-stone-800 rounded-full shadow-lg shadow-black/15 hover:bg-stone-700 transition tracking-[-0.14px]"
    >
      X(트위터) 공유
    </a>
    <button
      type="button"
      data-share="copy"
      class="inline-flex items-center gap-2 h-10 px-4 text-sm font-medium text-stone-700 bg-white border border-stone-200 rounded-full shadow-lg shadow-black/15 hover:bg-stone-100 transition tracking-[-0.14px]"
    >
      <span class="js-copy-label">링크 복사</span>
    </button>
  </div>

  <!-- 토글 버튼 -->
  <button
    type="button"
    data-fab-toggle
    aria-expanded="false"
    aria-label="공유하기"
    class="inline-flex items-center gap-2 h-12 pl-4 pr-5 text-sm font-semibold text-white bg-[#222222] rounded-full shadow-xl shadow-black/25 hover:bg-[#333333] transition tracking-[-0.14px]"
  >
    <svg class="fab-icon-share" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
    <span class="fab-toggle-label">공유하기</span>
  </button>
</div>

<script>
  import {
    copyShareLink,
    getStoredRef,
    track,
    SITE_URL,
  } from "/revote/revote-client.js";

  const SHARE_DESC =
    "투표용지가 부족했고, 일부 시민은 투표를 포기했습니다. 선거권 회복을 위한 100만 서명에 함께해주세요.";

  function currentRef() {
    return (window as any).__revoteRef || getStoredRef() || "";
  }
  function shareUrl() {
    const ref = currentRef();
    return SITE_URL + (ref ? `/?ref=${ref}&ch=` : "/?ch=");
  }

  function flashLabel(btn: HTMLElement, msg: string) {
    const label = btn.querySelector(".js-copy-label") as HTMLElement | null;
    const target = label || btn;
    const prev = target.textContent;
    target.textContent = msg;
    setTimeout(() => {
      target.textContent = prev;
    }, 1600);
  }

  async function kakaoShare(btn: HTMLElement) {
    const ref = currentRef();
    try {
      const mod = await import("/revote/kakao.js");
      if (mod && mod.shareKakao) {
        const ok = await mod.shareKakao({
          url: SITE_URL + (ref ? `/?ref=${ref}&ch=kakao` : "/?ch=kakao"),
          title: "선거권 회복 100만 서명운동",
          description: SHARE_DESC,
        });
        if (ok) {
          track("share_kakao_click", { ref });
          return;
        }
      }
    } catch (_) {}
    const ok = await copyShareLink(ref);
    track("copy_link_click", { channel: "kakao", ref });
    flashLabel(btn, ok ? "링크 복사됨!" : "복사 실패");
  }

  async function shareInstagram() {
    const ref = currentRef();
    const url = SITE_URL + (ref ? `/?ref=${ref}&ch=instagram` : "/?ch=instagram");
    const TITLE = "선거권 회복 100만 서명운동";

    let file: File | null = null;
    try {
      const resp = await fetch("https://aiparty.kr/og-main-v2.png");
      if (resp.ok) {
        const blob = await resp.blob();
        file = new File([blob], "revote.png", { type: blob.type || "image/png" });
      }
    } catch (_) {}

    if (file && navigator.canShare && navigator.canShare({ files: [file] })) {
      try {
        await navigator.share({ files: [file], title: TITLE, text: SHARE_DESC + "\n" + url });
        track("share_instagram_click", { ref, mode: "file" });
      } catch (_) {}
      return;
    }
    if (navigator.share) {
      try {
        await navigator.share({ title: TITLE, text: SHARE_DESC, url });
        track("share_instagram_click", { ref, mode: "url" });
      } catch (_) {}
      return;
    }
    const ok = await copyShareLink(ref);
    track("share_instagram_click", { ref, mode: "copy" });
    alert(
      ok
        ? "링크를 복사했어요. 인스타그램 앱에서 스토리에 붙여넣어 공유해주세요."
        : "인스타그램 앱에서 스토리로 공유해주세요."
    );
  }

  async function doCopy(btn: HTMLElement) {
    const ok = await copyShareLink(currentRef());
    track("copy_link_click", { channel: "link", ref: currentRef() });
    flashLabel(btn, ok ? "복사됨!" : "복사 실패");
  }

  const fab = document.querySelector(".revote-fab");
  if (fab) {
    const toggle = fab.querySelector("[data-fab-toggle]") as HTMLButtonElement;
    const menu = fab.querySelector("[data-fab-menu]") as HTMLElement;
    let open = false;

    function setOpen(next: boolean) {
      open = next;
      toggle.setAttribute("aria-expanded", String(open));
      if (open) {
        menu.classList.remove("opacity-0", "translate-y-2", "pointer-events-none");
        menu.classList.add("opacity-100", "translate-y-0", "pointer-events-auto");
      } else {
        menu.classList.add("opacity-0", "translate-y-2", "pointer-events-none");
        menu.classList.remove("opacity-100", "translate-y-0", "pointer-events-auto");
      }
    }

    toggle.addEventListener("click", (e) => {
      e.stopPropagation();
      setOpen(!open);
    });

    // 바깥 클릭 시 닫기
    document.addEventListener("click", (e) => {
      if (open && !fab.contains(e.target as Node)) setOpen(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && open) setOpen(false);
    });

    fab.querySelectorAll<HTMLElement>("[data-share]").forEach((btn) => {
      const kind = btn.dataset.share;
      if (kind === "x") {
        btn.addEventListener("click", (e) => {
          e.preventDefault();
          const u = shareUrl() + "x";
          const text = encodeURIComponent(SHARE_DESC + "\n" + u);
          window.open(`https://twitter.com/intent/tweet?text=${text}`, "_blank", "noopener");
          track("share_x_click", { ref: currentRef() });
          setOpen(false);
        });
        return;
      }
      btn.addEventListener("click", () => {
        if (kind === "kakao") kakaoShare(btn);
        else if (kind === "instagram") shareInstagram();
        else doCopy(btn);
      });
    });
  }
</script>
